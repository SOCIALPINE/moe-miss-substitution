new file mode 100644
index 0000000..060774a
--- /dev/null
+++ b/tools/xcache-bench/xcache-bench.cpp
@@ -0,0 +1,640 @@
+// Teacher-forced decode benchmark for the expert cache (LLAMA_XCACHE=1) and for stock llama.cpp.
+// For each session: prefill P tokens once, save the sequence state, then for every plan entry restore
+// the state and decode D tokens one by one (feeding the reference tokens), timing each token and
+// recording the NLL of the next reference token.
+// With --gen: for every plan entry, greedy generation from each prompt of the file (one JSON line per prompt).
+
+#include "llama.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+
+struct plan_item {
+    std::string key;
+    std::string mode; // "stock" or xcache mode
+    float frac = 0.25f;
+    std::string src = "nvme";
+    float tau = 2.0f;
+    std::string opts;
+};
+
+struct run_acc {
+    std::vector<double> ms;
+    std::vector<double> nll;
+    std::vector<int>    am;
+    llama_xcache_stats  st = {};
+    double cfg_ms = 0;
+    // per quarter of the decode (by position): wanted, hits, bytes
+    double q_want[4] = {0, 0, 0, 0}, q_hit[4] = {0, 0, 0, 0}, q_bytes[4] = {0, 0, 0, 0};
+};
+
+static double now_ms() {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static std::vector<std::string> split(const std::string & s, char d) {
+    std::vector<std::string> out;
+    std::stringstream ss(s);
+    std::string x;
+    while (std::getline(ss, x, d)) {
+        if (!x.empty()) {
+            out.push_back(x);
+        }
+    }
+    return out;
+}
+
+static double pct(std::vector<double> v, double p) {
+    if (v.empty()) {
+        return 0;
+    }
+    std::sort(v.begin(), v.end());
+    const double idx = p / 100.0 * (v.size() - 1);
+    const size_t i0 = (size_t) idx;
+    const size_t i1 = std::min(v.size() - 1, i0 + 1);
+    return v[i0] + (v[i1] - v[i0]) * (idx - i0);
+}
+
+int main(int argc, char ** argv) {
+    std::string model_path, tokens_path, out_path, plan_s = "stock", prompts_s, prefill_opts, gen_path, gen_range;
+    int ngl = 99, n_cpu_moe = 0, n_threads = 8, D = 256, max_sessions = 0, warm = 8, n_ubatch = 0, max_new = 1024;
+    bool cold = false;
+
+    for (int i = 1; i < argc; ++i) {
+        std::string a = argv[i];
+        auto next = [&]() -> std::string {
+            if (i + 1 >= argc) {
+                fprintf(stderr, "missing value for %s\n", a.c_str());
+                exit(1);
+            }
+            return argv[++i];
+        };
+        if      (a == "-m")            { model_path = next(); }
+        else if (a == "--tokens")      { tokens_path = next(); }
+        else if (a == "--out")         { out_path = next(); }
+        else if (a == "--plan")        { plan_s = next(); }
+        else if (a == "-ngl")          { ngl = atoi(next().c_str()); }
+        else if (a == "--n-cpu-moe")   { n_cpu_moe = atoi(next().c_str()); }
+        else if (a == "-t")            { n_threads = atoi(next().c_str()); }
+        else if (a == "--decode")      { D = atoi(next().c_str()); }
+        else if (a == "--sessions")    { max_sessions = atoi(next().c_str()); }
+        else if (a == "--warm")        { warm = atoi(next().c_str()); }
+        else if (a == "--prompts")     { prompts_s = next(); }         // prompt lengths, comma separated
+        else if (a == "--prefill-opts"){ prefill_opts = next(); }      // xcache options during prompt processing
+        else if (a == "--cold")        { cold = true; }                // drop host expert pages before every prompt
+        else if (a == "--ubatch")      { n_ubatch = atoi(next().c_str()); } // physical batch (default: the longest prompt)
+        else if (a == "--gen")         { gen_path = next(); }          // greedy generation: int32 N, then int32 len + tokens per prompt
+        else if (a == "--gen-range")   { gen_range = next(); }         // a:b, prompt indices of the generation file
+        else if (a == "--max-new")     { max_new = atoi(next().c_str()); }
+        else { fprintf(stderr, "unknown arg %s\n", a.c_str()); return 1; }
+    }
+
+    // plan: "stock" or "mode:frac:src[:tau[:opts]],..." with opts "key=value+key=value"
+    std::vector<plan_item> plan;
+    for (const auto & p : split(plan_s, ',')) {
+        auto f = split(p, ':');
+        plan_item it;
+        it.mode = f[0];
+        if (f.size() > 1) { it.frac = atof(f[1].c_str()); }
+        if (f.size() > 2) { it.src  = f[2]; }
+        if (f.size() > 3) { it.tau  = atof(f[3].c_str()); }
+        if (f.size() > 4) { it.opts = f[4]; }
+        char buf[128];
+        if (it.mode == "stock") {
+            snprintf(buf, sizeof(buf), "stock");
+        } else {
+            snprintf(buf, sizeof(buf), "%s@%.3g/%s%s", it.mode == "C" && it.tau > 1.0f ? "C1" : it.mode.c_str(), it.frac, it.src.c_str(),
+                     (it.mode == "C" && it.tau <= 1.0f) ? (":" + std::to_string(it.tau).substr(0, 4)).c_str() : "");
+        }
+        it.key = buf;
+        if (!it.opts.empty()) {
+            it.key += "|" + it.opts;
+        }
+        plan.push_back(it);
+    }
+
+    const bool gen = !gen_path.empty();
+    std::vector<std::vector<llama_token>> gp;
+    int g0 = 0;
+    if (gen) {
+        std::ifstream gf(gen_path, std::ios::binary);
+        int32_t ng = 0;
+        gf.read((char *) &ng, sizeof(ng));
+        std::vector<std::vector<llama_token>> all(std::max(0, ng));
+        for (auto & p : all) {
+            int32_t n = 0;
+            gf.read((char *) &n, sizeof(n));
+            p.resize(n);
+            gf.read((char *) p.data(), sizeof(llama_token) * n);
+        }
+        int g1 = (int) all.size();
+        if (!gen_range.empty() && sscanf(gen_range.c_str(), "%d:%d", &g0, &g1) != 2) {
+            fprintf(stderr, "bad --gen-range %s\n", gen_range.c_str());
+            return 1;
+        }
+        g0 = std::max(0, g0);
+        g1 = std::min(g1, (int) all.size());
+        if (!gf || g0 >= g1) {
+            fprintf(stderr, "no prompts in %s range %d:%d\n", gen_path.c_str(), g0, g1);
+            return 1;
+        }
+        gp.assign(all.begin() + g0, all.begin() + g1);
+    }
+
+    // tokens: int32 S, T, P, then S*T tokens
+    std::ifstream fin;
+    int32_t hdr[3] = { 0, 0, 0 };
+    if (!gen) {
+        fin.open(tokens_path, std::ios::binary);
+        fin.read((char *) hdr, sizeof(hdr));
+    }
+    const int S = hdr[0], T = hdr[1];
+    std::vector<int> prompts;
+    for (const auto & x : split(prompts_s, ',')) {
+        prompts.push_back(atoi(x.c_str()));
+    }
+    if (gen) {
+        prompts.assign(1, 1);
+        for (const auto & p : gp) {
+            prompts[0] = std::max(prompts[0], (int) p.size());
+        }
+    }
+    if (prompts.empty()) {
+        prompts.push_back(hdr[2]);
+    }
+    const int P_max = *std::max_element(prompts.begin(), prompts.end());
+    int P = prompts[0];
+    std::vector<int32_t> toks((size_t) S * T);
+    if (!gen) {
+        fin.read((char *) toks.data(), sizeof(int32_t) * toks.size());
+    }
+    const int n_sess = max_sessions > 0 ? std::min(S, max_sessions) : S;
+    D = gen ? max_new : std::min(D, T - P_max - 1);
+
+    llama_backend_init();
+
+    // experts of the first n_cpu_moe layers stay in host memory (mmap)
+    std::vector<std::string> patterns;
+    std::vector<llama_model_tensor_buft_override> ov;
+    ggml_backend_dev_t cpu_dev = ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU);
+    ggml_backend_buffer_type_t cpu_buft = ggml_backend_dev_buffer_type(cpu_dev);
+    for (int il = 0; il < n_cpu_moe; ++il) {
+        patterns.push_back("blk\\." + std::to_string(il) + "\\.ffn_(up|down|gate|gate_up)_(ch|)exps");
+    }
+    for (auto & p : patterns) {
+        ov.push_back({ p.c_str(), cpu_buft });
+    }
+    ov.push_back({ nullptr, nullptr });
+
+    llama_model_params mp = llama_model_default_params();
+    mp.n_gpu_layers = ngl;
+    mp.tensor_buft_overrides = ov.data();
+    const double t_load0 = now_ms();
+    llama_model * model = llama_model_load_from_file(model_path.c_str(), mp);
+    if (!model) {
+        fprintf(stderr, "failed to load model\n");
+        return 1;
+    }
+    const double t_load = now_ms() - t_load0;
+
+    llama_context_params cp = llama_context_default_params();
+    cp.n_ctx     = P_max + D + 64;
+    cp.n_batch   = std::max(512, P_max);
+    cp.n_ubatch  = n_ubatch > 0 ? n_ubatch : std::max(512, P_max);
+    cp.n_seq_max = 1;
+    cp.n_threads = n_threads;
+    cp.n_threads_batch = n_threads;
+    cp.no_perf   = true;
+    llama_context * ctx = llama_init_from_model(model, cp);
+    if (!ctx) {
+        fprintf(stderr, "failed to create context\n");
+        return 1;
+    }
+    const bool xc = llama_xcache_enabled(ctx);
+    const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    llama_memory_t mem = llama_get_memory(ctx);
+
+    fprintf(stderr, "xcache-bench: sessions %d x (P %d + D %d), plan %zu entries, xcache %d, load %.1fs\n",
+            n_sess, P, D, plan.size(), (int) xc, t_load / 1000.0);
+
+    if (gen) {
+        // greedy generation: for every plan entry and prompt, process the prompt, fill the cache from it, then decode
+        // until an end-of-generation token or max_new tokens; one JSON line per prompt
+        const llama_vocab * vocab = llama_model_get_vocab(model);
+        auto argmax = [&]() {
+            const float * lg = llama_get_logits_ith(ctx, -1);
+            int am = 0;
+            for (int v = 1; v < n_vocab; ++v) {
+                if (lg[v] > lg[am]) {
+                    am = v;
+                }
+            }
+            return (llama_token) am;
+        };
+        auto gen_prompt = [&](const std::vector<llama_token> & p, const plan_item & it, double * t_pf) {
+            llama_memory_clear(mem, true);
+            if (xc) {
+                llama_xcache_set_opts(ctx, prefill_opts.c_str());
+                llama_xcache_begin_prompt(ctx);
+            }
+            std::vector<llama_token> pt(p);
+            const double t0 = now_ms();
+            if (llama_decode(ctx, llama_batch_get_one(pt.data(), (int32_t) pt.size())) != 0) {
+                fprintf(stderr, "prefill failed\n");
+                exit(1);
+            }
+            const llama_token t = argmax();
+            *t_pf = now_ms() - t0;
+            if (xc && it.mode != "stock") {
+                llama_xcache_set_opts(ctx, it.opts.c_str());
+                if (llama_xcache_configure(ctx, it.mode.c_str(), it.frac, it.src.c_str(), it.tau) != 0) {
+                    fprintf(stderr, "configure failed for %s\n", it.key.c_str());
+                    exit(1);
+                }
+            }
+            return t;
+        };
+        {
+            double t_pf = 0;
+            llama_token t = gen_prompt(gp[0], plan[0], &t_pf);
+            for (int i = 0; i < warm; ++i) {
+                if (llama_decode(ctx, llama_batch_get_one(&t, 1)) != 0) {
+                    fprintf(stderr, "decode failed\n");
+                    exit(1);
+                }
+                t = argmax();
+            }
+        }
+        std::ofstream gout(out_path);
+        for (const auto & it : plan) {
+            for (size_t gi = 0; gi < gp.size(); ++gi) {
+                double t_pf = 0;
+                const double c0 = now_ms();
+                llama_token t = gen_prompt(gp[gi], it, &t_pf);
+                const double t_cfg = now_ms() - c0 - t_pf;
+                std::vector<llama_token> out;
+                double ms = 0;
+                bool eog = false;
+                for (;;) {
+                    out.push_back(t);
+                    if (llama_vocab_is_eog(vocab, t)) {
+                        eog = true;
+                        break;
+                    }
+                    if ((int) out.size() >= max_new) {
+                        break;
+                    }
+                    const double d0 = now_ms();
+                    if (llama_decode(ctx, llama_batch_get_one(&t, 1)) != 0) {
+                        fprintf(stderr, "decode failed\n");
+                        exit(1);
+                    }
+                    llama_get_logits_ith(ctx, -1);
+                    ms += now_ms() - d0;
+                    t = argmax();
+                }
+                llama_xcache_stats st = {};
+                if (xc && it.mode != "stock") {
+                    llama_xcache_get_stats(ctx, &st);
+                }
+                const int n_dec = (int) out.size() - 1;
+                gout << "{\"plan\":\"" << it.key << "\",\"i\":" << g0 + (int) gi << ",\"np\":" << gp[gi].size() << ",\"n\":" << out.size()
+                     << ",\"eog\":" << (eog ? 1 : 0) << ",\"pf_ms\":" << t_pf << ",\"cfg_ms\":" << t_cfg << ",\"ms\":" << ms
+                     << ",\"mass\":" << st.mass << ",\"ltok\":" << st.n_ltok << ",\"want\":" << st.n_want << ",\"hit\":" << st.n_hit
+                     << ",\"sub\":" << st.n_sub << ",\"bg\":" << st.n_bg << ",\"bytes\":" << st.bytes << ",\"stall_ms\":" << st.stall_ms
+                     << ",\"toks\":[";
+                for (size_t k = 0; k < out.size(); ++k) {
+                    gout << (k ? "," : "") << out[k];
+                }
+                gout << "]}\n";
+                gout.flush();
+                fprintf(stderr, "gen %-22s %4d  n %4zu%s  %6.2f ms/tok  mass %.4f  prefill %.2fs\n", it.key.c_str(), g0 + (int) gi,
+                        out.size(), eog ? "" : "+", n_dec > 0 ? ms / n_dec : 0.0, st.n_ltok > 0 ? st.mass / st.n_ltok : 0.0, t_pf / 1000.0);
+            }
+        }
+        printf("GEN_DONE %zu prompts x %zu plans\n", gp.size(), plan.size());
+        fflush(stdout);
+        llama_free(ctx);
+        llama_model_free(model);
+        llama_backend_free();
+        return 0;
+    }
+
+    std::map<std::string, run_acc> acc;
+    std::vector<double> ttft;
+    std::map<int, std::vector<double>> ttft_p, cfg_p; // per prompt length: prompt processing, cache fill of the first plan entry
+    // prompt streaming: load ms, GB read from the file, GB copied on the device, experts used, read ahead, read ahead and used,
+    // GB copied from the page cache; decode ms of the first plan entry per session
+    std::map<int, std::vector<double>> pfms_p, pfrd_p, pfdd_p, pfus_p, pfpr_p, pfph_p, pfrm_p, rfr_p, ron_p, dec_p;
+    std::vector<uint8_t> state;
+    size_t off = 0; // token offset inside a session (the warm-up uses the end of session 0, which is never measured)
+
+    auto prefill = [&](int s) -> double {
+        llama_memory_clear(mem, true);
+        if (xc) {
+            if (cold) {
+                llama_xcache_evict_host(ctx);
+            }
+            llama_xcache_set_opts(ctx, prefill_opts.c_str());
+            llama_xcache_begin_prompt(ctx);
+        }
+        std::vector<llama_token> pt(toks.begin() + (size_t) s * T + off, toks.begin() + (size_t) s * T + off + P);
+        const double t0 = now_ms();
+        if (llama_decode(ctx, llama_batch_get_one(pt.data(), P)) != 0) {
+            fprintf(stderr, "prefill failed\n");
+            exit(1);
+        }
+        llama_get_logits_ith(ctx, -1);
+        const double dt = now_ms() - t0;
+        if (xc) {
+            llama_xcache_stats ps;
+            llama_xcache_get_stats(ctx, &ps);
+            pfms_p[P].push_back(ps.pf_ms);
+            pfrd_p[P].push_back(ps.pf_read_bytes / 1e9);
+            pfrm_p[P].push_back(ps.pf_ram_bytes / 1e9);
+            pfdd_p[P].push_back(ps.pf_d2d_bytes / 1e9);
+            pfus_p[P].push_back((double) ps.pf_used);
+            pfpr_p[P].push_back((double) ps.pf_pre);
+            pfph_p[P].push_back((double) ps.pf_pre_hit);
+            rfr_p[P].push_back(ps.ram_frac); // option ram=2: resident fraction of the expert pages (-1: not decided)
+            ron_p[P].push_back((double) ps.ram_on);
+        }
+        state.resize(llama_state_seq_get_size(ctx, 0));
+        llama_state_seq_get_data(ctx, state.data(), state.size(), 0);
+        return dt;
+    };
+
+    auto run = [&](int s, const plan_item & it, int n_dec, run_acc * a) {
+        llama_memory_seq_rm(mem, 0, -1, -1);
+        llama_state_seq_set_data(ctx, state.data(), state.size(), 0);
+        if (it.mode != "stock") {
+            const double c0 = now_ms();
+            llama_xcache_set_opts(ctx, it.opts.c_str());
+            if (llama_xcache_configure(ctx, it.mode.c_str(), it.frac, it.src.c_str(), it.tau) != 0) {
+                fprintf(stderr, "configure failed for %s\n", it.key.c_str());
+                exit(1);
+            }
+            if (a) {
+                a->cfg_ms += now_ms() - c0;
+                if (&it == &plan[0]) {
+                    cfg_p[P].push_back(now_ms() - c0);
+                }
+            }
+        }
+        const bool track = a && xc && it.mode != "stock";
+        int64_t pw = 0, ph = 0, pb = 0;
+        int q = 0;
+        for (int i = 0; i < n_dec; ++i) {
+            llama_token tk = toks[(size_t) s * T + off + P + i];
+            const double t0 = now_ms();
+            if (llama_decode(ctx, llama_batch_get_one(&tk, 1)) != 0) {
+                fprintf(stderr, "decode failed\n");
+                exit(1);
+            }
+            const float * lg = llama_get_logits_ith(ctx, -1);
+            const double dt = now_ms() - t0;
+            if (!a) {
+                continue;
+            }
+            const int target = toks[(size_t) s * T + off + P + i + 1];
+            float mx = lg[0];
+            int am = 0;
+            for (int v = 1; v < n_vocab; ++v) {
+                if (lg[v] > mx) {
+                    mx = lg[v];
+                    am = v;
+                }
+            }
+            double se = 0;
+            for (int v = 0; v < n_vocab; ++v) {
+                se += std::exp((double) lg[v] - mx);
+            }
+            a->ms.push_back(dt);
+            a->nll.push_back(std::log(se) + mx - lg[target]);
+            a->am.push_back(am);
+            if (track && q < 4 && i + 1 == (int) ((int64_t) n_dec * (q + 1) / 4)) {
+                llama_xcache_stats qs;
+                llama_xcache_get_stats(ctx, &qs);
+                a->q_want[q]  += (double) (qs.n_want - pw);
+                a->q_hit[q]   += (double) (qs.n_hit - ph);
+                a->q_bytes[q] += (double) (qs.bytes - pb);
+                pw = qs.n_want;
+                ph = qs.n_hit;
+                pb = qs.bytes;
+                q++;
+            }
+        }
+        if (a && xc && it.mode != "stock") {
+            llama_xcache_stats st;
+            llama_xcache_get_stats(ctx, &st);
+            a->st.stall_ms += st.stall_ms;
+            a->st.wait_pending_ms += st.wait_pending_ms;
+            a->st.cb_ms += st.cb_ms;
+            a->st.n_tok += st.n_tok;
+            a->st.n_want += st.n_want;
+            a->st.n_hit += st.n_hit;
+            a->st.n_sub += st.n_sub;
+            a->st.n_urg += st.n_urg;
+            a->st.n_bg += st.n_bg;
+            a->st.n_cancel += st.n_cancel;
+            a->st.n_drop += st.n_drop;
+            a->st.n_steal += st.n_steal;
+            a->st.bytes += st.bytes;
+            a->st.n_skip += st.n_skip;
+            a->st.mass += st.mass;
+            a->st.n_ltok += st.n_ltok;
+        }
+    };
+
+    // warm-up on the end of the first session, so that no measured prompt has been seen before
+    if (T - P - warm - 2 >= P_max + D + 1) {
+        off = (size_t) (T - P - warm - 2);
+    }
+    prefill(0);
+    for (const auto & it : plan) {
+        run(0, it, warm, nullptr);
+    }
+    off = 0;
+    pfms_p.clear();
+    pfrd_p.clear();
+    pfdd_p.clear();
+    pfus_p.clear();
+    pfpr_p.clear();
+    pfph_p.clear();
+    pfrm_p.clear();
+    rfr_p.clear();
+    ron_p.clear();
+    dec_p.clear();
+
+    for (int pi = 0; pi < (int) prompts.size(); ++pi)
+    for (int s = 0; s < n_sess; ++s) {
+        P = prompts[pi];
+        const double tt = prefill(s);
+        ttft.push_back(tt);
+        ttft_p[P].push_back(tt);
+        for (const auto & it : plan) {
+            run_acc & a = acc[it.key];
+            const size_t n0 = a.ms.size();
+            run(s, it, D, &a);
+            double m = 0, nl = 0;
+            for (size_t i = n0; i < a.ms.size(); ++i) {
+                m += a.ms[i];
+                nl += a.nll[i];
+            }
+            if (&it == &plan[0]) {
+                dec_p[P].push_back(m); // time to generate the D tokens of this session
+            }
+            fprintf(stderr, "session %d/%d %-22s %7.2f ms/tok  ppl %.3f  (prefill %.2fs)\n", s + 1, n_sess, it.key.c_str(),
+                    m / (a.ms.size() - n0), std::exp(nl / (a.ms.size() - n0)), tt / 1000.0);
+        }
+    }
+
+    // summary
+    const run_acc * ref = nullptr;
+    for (const auto & it : plan) {
+        if (it.mode == "exact" || it.mode == "stock") {
+            ref = &acc[it.key];
+            break;
+        }
+    }
+    std::ostringstream js, raw;
+    js << "{\"model\":\"" << model_path << "\",\"n_cpu_moe\":" << n_cpu_moe << ",\"threads\":" << n_threads
+       << ",\"xcache\":" << (xc ? 1 : 0) << ",\"P\":" << P << ",\"D\":" << D << ",\"sessions\":" << n_sess
+       << ",\"load_s\":" << t_load / 1000.0 << ",\"ttft_ms\":[";
+    for (size_t i = 0; i < ttft.size(); ++i) {
+        js << (i ? "," : "") << ttft[i];
+    }
+    js << "],\"ttft_by_p\":{";
+    {
+        bool f1 = true;
+        for (auto & kv : ttft_p) {
+            js << (f1 ? "" : ",") << "\"" << kv.first << "\":{\"prefill\":[";
+            for (size_t i = 0; i < kv.second.size(); ++i) {
+                js << (i ? "," : "") << kv.second[i];
+            }
+            js << "],\"fill\":[";
+            const auto & cf = cfg_p[kv.first];
+            for (size_t i = 0; i < cf.size(); ++i) {
+                js << (i ? "," : "") << cf[i];
+            }
+            js << "]";
+            const std::pair<const char *, std::map<int, std::vector<double>> *> extra[] = {
+                { "pf_ms", &pfms_p }, { "pf_read_GB", &pfrd_p }, { "pf_d2d_GB", &pfdd_p }, { "pf_used", &pfus_p }, { "pf_pre", &pfpr_p }, { "pf_pre_hit", &pfph_p }, { "pf_ram_GB", &pfrm_p }, { "ram_frac", &rfr_p }, { "ram_on", &ron_p }, { "dec_ms", &dec_p } };
+            for (const auto & x : extra) {
+                const auto & v = (*x.second)[kv.first];
+                js << ",\"" << x.first << "\":[";
+                for (size_t i = 0; i < v.size(); ++i) {
+                    js << (i ? "," : "") << v[i];
+                }
+                js << "]";
+            }
+            js << "}";
+            f1 = false;
+        }
+    }
+    js << "},\"cold\":" << (cold ? 1 : 0) << ",\"prefill_opts\":\"" << prefill_opts << "\",\"runs\":{";
+    raw << "{";
+    bool first = true;
+    for (const auto & it : plan) {
+        const run_acc & a = acc[it.key];
+        const size_t n = a.ms.size();
+        double m = 0, nl = 0;
+        for (size_t i = 0; i < n; ++i) {
+            m += a.ms[i];
+            nl += a.nll[i];
+        }
+        m /= n;
+        nl /= n;
+        double agree = -1, dppl = 0;
+        if (ref && ref->ms.size() == n) {
+            int same = 0;
+            double rnl = 0;
+            for (size_t i = 0; i < n; ++i) {
+                same += a.am[i] == ref->am[i];
+                rnl += ref->nll[i];
+            }
+            agree = (double) same / n;
+            dppl = 100.0 * (std::exp(nl - rnl / n) - 1.0);
+        }
+        const double nt = std::max<int64_t>(1, a.st.n_tok);
+        js << (first ? "" : ",") << "\"" << it.key << "\":{\"ms_mean\":" << m << ",\"ms_p50\":" << pct(a.ms, 50)
+           << ",\"ms_p90\":" << pct(a.ms, 90) << ",\"tok_s\":" << 1000.0 / m << ",\"ppl\":" << std::exp(nl)
+           << ",\"dppl_pct\":" << dppl << ",\"agree\":" << agree;
+        if (it.mode != "stock") {
+            js << ",\"stall_ms\":" << a.st.stall_ms / nt << ",\"wait_pending_ms\":" << a.st.wait_pending_ms / nt
+               << ",\"cb_ms\":" << a.st.cb_ms / nt << ",\"hit\":" << (double) a.st.n_hit / std::max<int64_t>(1, a.st.n_want)
+               << ",\"subst\":" << (double) a.st.n_sub / std::max<int64_t>(1, a.st.n_want)
+               << ",\"urg_per_tok\":" << a.st.n_urg / nt << ",\"bg_per_tok\":" << a.st.n_bg / nt
+               << ",\"drop_per_tok\":" << a.st.n_drop / nt << ",\"cancel_per_tok\":" << a.st.n_cancel / nt
+               << ",\"steal_per_tok\":" << a.st.n_steal / nt << ",\"skip_per_tok\":" << a.st.n_skip / nt << ",\"MB_per_tok\":" << a.st.bytes / nt / 1e6
+               << ",\"cfg_ms\":" << a.cfg_ms / n_sess << ",\"mass\":" << a.st.mass / std::max<int64_t>(1, a.st.n_ltok);
+        }
+        // by quarter of the decode position
+        {
+            double qn[4] = {0, 0, 0, 0}, qnl[4] = {0, 0, 0, 0}, qrnl[4] = {0, 0, 0, 0}, qms[4] = {0, 0, 0, 0};
+            for (size_t i = 0; i < n; ++i) {
+                const int b = std::min(3, (int) ((i % D) * 4 / D));
+                qn[b] += 1;
+                qnl[b] += a.nll[i];
+                qms[b] += a.ms[i];
+                if (ref && ref->ms.size() == n) {
+                    qrnl[b] += ref->nll[i];
+                }
+            }
+            auto arr = [&](const char * name, auto f) {
+                js << ",\"" << name << "\":[";
+                for (int b = 0; b < 4; ++b) {
+                    js << (b ? "," : "") << f(b);
+                }
+                js << "]";
+            };
+            arr("q_ms", [&](int b) { return qn[b] > 0 ? qms[b] / qn[b] : 0.0; });
+            arr("q_ppl", [&](int b) { return qn[b] > 0 ? std::exp(qnl[b] / qn[b]) : 0.0; });
+            if (ref && ref->ms.size() == n) {
+                arr("q_dppl", [&](int b) { return qn[b] > 0 ? 100.0 * (std::exp((qnl[b] - qrnl[b]) / qn[b]) - 1.0) : 0.0; });
+            }
+            if (it.mode != "stock") {
+                arr("q_hit", [&](int b) { return a.q_want[b] > 0 ? a.q_hit[b] / a.q_want[b] : 0.0; });
+                arr("q_MB", [&](int b) { return qn[b] > 0 ? a.q_bytes[b] / qn[b] / 1e6 : 0.0; });
+            }
+        }
+        js << "}";
+        raw << (first ? "" : ",") << "\"" << it.key << "\":{\"nll\":[";
+        for (size_t i = 0; i < n; ++i) {
+            raw << (i ? "," : "") << a.nll[i];
+        }
+        raw << "],\"am\":[";
+        for (size_t i = 0; i < n; ++i) {
+            raw << (i ? "," : "") << a.am[i];
+        }
+        raw << "],\"ms\":[";
+        for (size_t i = 0; i < n; ++i) {
+            raw << (i ? "," : "") << a.ms[i];
+        }
+        raw << "]}";
+        first = false;
+    }
+    js << "}}";
+    raw << "}";
+    printf("SECTION_XC %s\n", js.str().c_str());
+    fflush(stdout);
+    if (!out_path.empty()) {
+        std::ofstream(out_path) << js.str() << "\n";
+        std::ofstream(out_path + ".raw.json") << raw.str() << "\n";
+    }
+
+    llama_free(ctx);
+    llama_model_free(model);
+    llama_backend_free();
+    return 0;
+}
