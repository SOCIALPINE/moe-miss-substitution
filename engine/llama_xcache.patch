+    LLAMA_API int32_t llama_xcache_configure   (struct llama_context * ctx, const char * mode, float frac, const char * src, float tau);
+    LLAMA_API void    llama_xcache_get_stats   (struct llama_context * ctx, struct llama_xcache_stats * out);
+    // options, "key=value+key=value": aio, uf, up, adm, sbg, bg, ef, ps, fresh (0/1), lam (LRFU decay per token), pf (prefill read-ahead layers),
