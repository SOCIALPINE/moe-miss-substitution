+    // flight per layer, default 8)
+    // env LLAMA_XCACHE_CAPS: one weight per MoE layer, slots per layer in that proportion at the same total device memory
+    LLAMA_API int32_t llama_xcache_set_opts    (struct llama_context * ctx, const char * opts);
+    // drop the host copies of the expert weights from memory (mapping + page cache), to measure a cold start
