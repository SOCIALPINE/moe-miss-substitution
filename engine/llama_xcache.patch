diff --git a/src/llama-xcache.cpp b/src/llama-xcache.cpp
new file mode 100644
index 0000000..5d37904
--- /dev/null
+++ b/src/llama-xcache.cpp
@@ -0,0 +1,1619 @@
+#include "llama-xcache.h"
+
+#include "llama.h"
+#include "llama-impl.h"
+#include "llama-model.h"
+
+#include "gguf.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstring>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <stdexcept>
+#include <thread>
+#include <unistd.h>
+
+enum { XC_QUEUED = 0, XC_RUNNING = 1, XC_DONE = 2, XC_CANCELLED = 3 };
+enum { XC_HOOK_DECODE = 0, XC_HOOK_PREFILL = 1 };
+
+static constexpr int    XC_N_URG = 12;
+static constexpr int    XC_N_BG  = 4;
+static constexpr size_t XC_ALIGN = 4096;
+
+struct llama_xc_job {
+    int il;
+    int e;
+    int slot;
+    std::atomic<int> st{XC_QUEUED};
+};
+
+static double xc_now_ms() {
+    return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+llama_xcache::llama_xcache(const llama_model & model, const char * gguf_path, float frac_max) {
+    const auto & hp = model.hparams;
+    n_expert = (int) hp.n_expert;
+    n_used   = (int) hp.n_expert_used();
+    cap_max  = std::min(n_expert, std::max(n_used + 1, (int) std::lround(frac_max * n_expert)));
+    cap      = cap_max;
+
+    const int n_layer = (int) hp.n_layer();
+    layers.resize(n_layer);
+
+    // file offsets of the expert tensors
+    gguf_init_params gp = { /*.no_alloc =*/ true, /*.ctx =*/ nullptr };
+    gguf_context * g = gguf_init_from_file(gguf_path, gp);
+    if (!g) {
+        throw std::runtime_error(std::string("xcache: cannot read gguf ") + gguf_path);
+    }
+    const size_t data_off = gguf_get_data_offset(g);
+
+    ggml_backend_buffer_type_t buft = nullptr;
+    int n_pool_tensors = 0;
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & ly = model.layers[il];
+        if (!ly.ffn_gate_inp || !ly.ffn_down_exps) {
+            continue;
+        }
+        auto & L = layers[il];
+        std::vector<ggml_tensor *> src;
+        if (ly.ffn_gate_up_exps) {
+            src = { ly.ffn_gate_up_exps, ly.ffn_down_exps };
+        } else {
+            src = { ly.ffn_gate_exps, ly.ffn_up_exps, ly.ffn_down_exps };
+        }
+        bool ok = true;
+        for (auto * t : src) {
+            ok = ok && t && t->buffer && ggml_backend_buffer_is_host(t->buffer) && t->ne[2] == n_expert;
+        }
+        if (!ok) {
+            LLAMA_LOG_WARN("%s: layer %d experts are not in host memory, layer skipped\n", __func__, il);
+            continue;
+        }
+        L.il  = il;
+        L.src = src;
+        for (auto * t : src) {
+            const int64_t id = gguf_find_tensor(g, ggml_get_name(t));
+            if (id < 0) {
+                throw std::runtime_error(std::string("xcache: tensor not in gguf: ") + ggml_get_name(t));
+            }
+            L.foff.push_back(data_off + gguf_get_tensor_offset(g, id));
+            L.nb2.push_back(t->nb[2]);
+        }
+        if (!buft) {
+            buft = ggml_backend_buffer_get_type(ly.ffn_gate_inp->buffer);
+        }
+        n_pool_tensors += (int) src.size() + 1;
+    }
+    gguf_free(g);
+    if (!buft) {
+        throw std::runtime_error("xcache: no MoE layer with host experts");
+    }
+
+    // slots per layer: cap_max everywhere, or shares from LLAMA_XCACHE_CAPS (one weight per MoE layer, comma separated),
+    // scaled so that the pools take the same device memory as cap_max slots in every layer
+    {
+        std::vector<int> moe;
+        for (int il = 0; il < n_layer; ++il) {
+            if (layers[il].il >= 0) {
+                moe.push_back(il);
+            }
+        }
+        std::vector<double> w(moe.size(), 1.0);
+        if (const char * cs = getenv("LLAMA_XCACHE_CAPS"); cs && *cs) {
+            std::vector<double> v;
+            for (const char * p = cs; *p;) {
+                char * end = nullptr;
+                const double x = strtod(p, &end);
+                if (end == p) {
+                    break;
+                }
+                v.push_back(x);
+                p = *end == ',' ? end + 1 : end;
+            }
+            if (v.size() != moe.size()) {
+                throw std::runtime_error("xcache: LLAMA_XCACHE_CAPS needs one weight per MoE layer");
+            }
+            w = v;
+        }
+        double b_all = 0, b_w = 0;
+        for (size_t i = 0; i < moe.size(); ++i) {
+            size_t b = 0;
+            for (auto x : layers[moe[i]].nb2) {
+                b += x;
+            }
+            b_all += (double) cap_max * b;
+            b_w   += w[i] * b;
+        }
+        for (size_t i = 0; i < moe.size(); ++i) {
+            auto & L = layers[moe[i]];
+            L.cap_max = std::min(n_expert, std::max(n_used + 1, (int) std::lround(w[i] * b_all / b_w)));
+            L.cap     = L.cap_max;
+        }
+    }
+
+    // device pools
+    ggml_init_params ip = { /*.mem_size =*/ ggml_tensor_overhead() * (size_t) (n_pool_tensors + 8), /*.mem_buffer =*/ nullptr, /*.no_alloc =*/ true };
+    ctx_pool = ggml_init(ip);
+    size_t max_stage = 0;
+    for (auto & L : layers) {
+        if (L.il < 0) {
+            continue;
+        }
+        size_t st = 0;
+        for (size_t k = 0; k < L.src.size(); ++k) {
+            ggml_tensor * s = L.src[k];
+            ggml_tensor * p = ggml_new_tensor_3d(ctx_pool, s->type, s->ne[0], s->ne[1], L.cap_max);
+            ggml_format_name(p, "xc_pool_%d_%zu", L.il, k);
+            GGML_ASSERT(p->nb[2] == s->nb[2]);
+            L.pool.push_back(p);
+            st += (L.nb2[k] + 2 * XC_ALIGN) / XC_ALIGN * XC_ALIGN;
+        }
+        L.slot_map = ggml_new_tensor_2d(ctx_pool, GGML_TYPE_I32, 1, n_expert);
+        ggml_format_name(L.slot_map, "xc_slot_map_%d", L.il);
+        max_stage = std::max(max_stage, st);
+        expert_bytes = 0;
+        for (auto b : L.nb2) {
+            expert_bytes += b;
+        }
+        L.state.assign(n_expert, 0);
+        L.slot_of.assign(n_expert, -1);
+        L.slot_e.assign(L.cap_max, -1);
+        L.rec.assign(n_expert, -1.0);
+        L.prompt_rec.assign(n_expert, -1.0);
+        L.rv.assign(n_expert, 0.0);
+        L.rt.assign(n_expert, 0.0);
+        L.slot_map_host.assign(n_expert, 0);
+    }
+    if (ggml_backend_dev_t pdev = ggml_backend_buft_get_device(buft)) {
+        buft = ggml_backend_dev_buffer_type(pdev); // default buffer type of the device (not a mapped one)
+    }
+    buft_dev = buft;
+    buf_pool = ggml_backend_alloc_ctx_tensors_from_buft(ctx_pool, buft);
+    if (!buf_pool) {
+        throw std::runtime_error("xcache: failed to allocate expert pools");
+    }
+    ggml_backend_buffer_clear(buf_pool, 0);
+    ggml_backend_buffer_set_usage(buf_pool, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    // pinned staging buffers: urgent workers, background workers, main thread
+    stage_size = (max_stage + XC_ALIGN - 1) / XC_ALIGN * XC_ALIGN;
+    const int n_stage = XC_N_URG + XC_N_BG + 1;
+    const size_t host_size = stage_size * n_stage + XC_ALIGN;
+    ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+    ggml_backend_buffer_type_t host_buft = dev ? ggml_backend_dev_host_buffer_type(dev) : nullptr;
+    if (host_buft) {
+        buf_host = ggml_backend_buft_alloc_buffer(host_buft, host_size);
+    }
+    uint8_t * base = nullptr;
+    if (buf_host) {
+        base = (uint8_t *) ggml_backend_buffer_get_base(buf_host);
+    } else {
+        host_fallback.resize(host_size);
+        base = host_fallback.data();
+    }
+    host_base = base + ((XC_ALIGN - ((uintptr_t) base % XC_ALIGN)) % XC_ALIGN);
+    pool_dev  = dev;
+
+    // pinned scratch for the per-layer routing copies
+    const size_t io_stride = ((size_t) (3 * n_used + 2 * n_expert) * 4 + 255) / 256 * 256;
+    const size_t io_size   = io_stride * layers.size() + 256;
+    if (host_buft) {
+        buf_io = ggml_backend_buft_alloc_buffer(host_buft, io_size);
+    }
+    uint8_t * iob = nullptr;
+    if (buf_io) {
+        iob = (uint8_t *) ggml_backend_buffer_get_base(buf_io);
+    } else {
+        io_fallback.resize(io_size);
+        iob = io_fallback.data();
+    }
+    iob += (256 - ((uintptr_t) iob % 256)) % 256;
+    for (size_t i = 0; i < layers.size(); ++i) {
+        auto & L = layers[i];
+        uint8_t * q = iob + i * io_stride;
+        L.io_gids = (int32_t *) q; q += 4 * n_used;
+        L.io_ids  = (int32_t *) q; q += 4 * n_used;
+        L.io_w    = (float   *) q; q += 4 * n_used;
+        L.io_gz   = (float   *) q; q += 4 * n_expert;
+        L.io_map  = (int32_t *) q;
+    }
+
+    fd_direct = open(gguf_path, O_RDONLY | O_DIRECT);
+    if (fd_direct >= 0) {
+        // probe: an aligned read must work
+        if (pread(fd_direct, host_base, XC_ALIGN, 0) != (ssize_t) XC_ALIGN) {
+            close(fd_direct);
+            fd_direct = -1;
+        }
+    }
+    fd_buffered = open(gguf_path, O_RDONLY);
+    if (fd_buffered < 0) {
+        throw std::runtime_error("xcache: cannot open gguf for reading");
+    }
+    posix_fadvise(fd_buffered, 0, 0, POSIX_FADV_RANDOM);
+
+
+    if (const char * tp = getenv("LLAMA_XCACHE_TRACE"); tp && *tp) {
+        trace = fopen(tp, "w");
+    }
+
+    for (int i = 0; i < XC_N_BG; ++i) {
+        bg_threads.emplace_back([this, i] { bg_worker(i); });
+    }
+    for (int i = 0; i < XC_N_URG; ++i) {
+        u_threads.emplace_back([this, i] { u_worker(i); });
+    }
+
+    int cmin = n_expert, cmax = 0;
+    for (const auto & L : layers) {
+        if (L.il >= 0) {
+            cmin = std::min(cmin, L.cap_max);
+            cmax = std::max(cmax, L.cap_max);
+        }
+    }
+    LLAMA_LOG_INFO("%s: experts %d, used %d, slots %d per layer (%d..%d), pools %.2f GiB (%s), expert %.2f MiB, O_DIRECT %s\n",
+            __func__, n_expert, n_used, cap_max, cmin, cmax, ggml_backend_buffer_get_size(buf_pool) / 1024.0 / 1024.0 / 1024.0,
+            ggml_backend_buft_name(buft), expert_bytes / 1024.0 / 1024.0, fd_direct >= 0 ? "yes" : "no");
+}
+
+llama_xcache::~llama_xcache() {
+    drain();
+    {
+        std::lock_guard<std::mutex> lk(bg_mtx);
+        stopping = true;
+    }
+    bg_cv.notify_all();
+    {
+        std::lock_guard<std::mutex> lk(u_mtx);
+        stopping = true;
+        u_gen++;
+    }
+    u_cv.notify_all();
+    for (auto & t : bg_threads) {
+        t.join();
+    }
+    for (auto & t : u_threads) {
+        t.join();
+    }
+    {
+        std::lock_guard<std::mutex> lk(pf_mtx);
+        stopping = true;
+    }
+    pf_cv.notify_all();
+    if (pf_thread.joinable()) {
+        pf_thread.join();
+    }
+    if (trace) {
+        fclose(trace);
+    }
+    if (fd_direct >= 0) {
+        close(fd_direct);
+    }
+    if (fd_buffered >= 0) {
+        close(fd_buffered);
+    }
+    if (buf_pool) {
+        ggml_backend_buffer_free(buf_pool);
+    }
+    if (buf_host) {
+        ggml_backend_buffer_free(buf_host);
+    }
+    if (buf_io) {
+        ggml_backend_buffer_free(buf_io);
+    }
+    if (buf_stage) {
+        ggml_backend_buffer_free(buf_stage);
+    }
+    if (ctx_stage) {
+        ggml_free(ctx_stage);
+    }
+    if (ctx_pool) {
+        ggml_free(ctx_pool);
+    }
+}
+
+//
+// graph build
+//
+
+void llama_xcache::begin_graph() {
+    hooks.clear();
+    for (auto & L : layers) {
+        L.h_logits = L.h_ids = L.h_w = nullptr;
+    }
+}
+
+ggml_tensor * llama_xcache::get_pool(int il, ggml_tensor * src_t) const {
+    const auto & L = layers[il];
+    for (size_t k = 0; k < L.src.size(); ++k) {
+        if (L.src[k] == src_t) {
+            return L.pool[k];
+        }
+    }
+    return nullptr;
+}
+
+ggml_tensor * llama_xcache::get_stage(int il, ggml_tensor * src_t) const {
+    const auto & L = layers[il];
+    for (size_t k = 0; k < L.src.size() && k < L.stg.size(); ++k) {
+        if (L.src[k] == src_t) {
+            return L.stg[k];
+        }
+    }
+    return nullptr;
+}
+
+// one device area with the layout of a whole layer (all experts); every layer gets tensors that alias it,
+// the prompt pass refills it layer by layer from the routing callback
+bool llama_xcache::alloc_stage() {
+    if (buf_stage) {
+        return true;
+    }
+    const size_t align = std::max<size_t>(256, ggml_backend_buft_get_alignment(buft_dev));
+    size_t need = 0;
+    int n_t = 0;
+    for (const auto & L : layers) {
+        if (L.il < 0) {
+            continue;
+        }
+        size_t sz = 0;
+        for (size_t k = 0; k < L.src.size(); ++k) {
+            sz += (L.nb2[k] * (size_t) n_expert + align - 1) / align * align;
+        }
+        need = std::max(need, sz);
+        n_t += (int) L.src.size();
+    }
+    need = (need + align - 1) / align * align;
+    buf_stage = ggml_backend_buft_alloc_buffer(buft_dev, 2 * need + align);
+    if (!buf_stage) {
+        LLAMA_LOG_WARN("%s: cannot allocate %.2f GiB of staging for prompt streaming\n", __func__, need / 1024.0 / 1024.0 / 1024.0);
+        return false;
+    }
+    ggml_backend_buffer_set_usage(buf_stage, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    ggml_init_params ip = { /*.mem_size =*/ ggml_tensor_overhead() * (size_t) (n_t + 8), /*.mem_buffer =*/ nullptr, /*.no_alloc =*/ true };
+    ctx_stage = ggml_init(ip);
+    uint8_t * base = (uint8_t *) ggml_backend_buffer_get_base(buf_stage);
+    base += (align - ((uintptr_t) base % align)) % align;
+    int ord = 0;
+    for (auto & L : layers) {
+        if (L.il < 0) {
+            continue;
+        }
+        size_t off = (size_t) (ord++ % 2) * need; // consecutive MoE layers use different areas
+        L.stg.clear();
+        for (size_t k = 0; k < L.src.size(); ++k) {
+            ggml_tensor * s = L.src[k];
+            ggml_tensor * t = ggml_new_tensor_3d(ctx_stage, s->type, s->ne[0], s->ne[1], n_expert);
+            ggml_format_name(t, "xc_stage_%d_%zu", L.il, k);
+            GGML_ASSERT(t->nb[2] == s->nb[2]);
+            if (ggml_backend_tensor_alloc(buf_stage, t, base + off) != GGML_STATUS_SUCCESS) {
+                LLAMA_LOG_WARN("%s: staging tensor alloc failed\n", __func__);
+                return false;
+            }
+            L.stg.push_back(t);
+            off += (L.nb2[k] * (size_t) n_expert + align - 1) / align * align;
+        }
+    }
+    LLAMA_LOG_INFO("%s: prompt streaming staging 2 x %.2f GiB\n", __func__, need / 1024.0 / 1024.0 / 1024.0);
+    return true;
+}
+
+void llama_xcache::hook_prefill(int il, ggml_tensor * ids) {
+    hooks[ids] = { il, XC_HOOK_PREFILL };
+}
+
+void llama_xcache::hook_decode(int il, ggml_tensor * logits, ggml_tensor * ids, ggml_tensor * w, bool norm_w, float w_scale) {
+    auto & L = layers[il];
+    L.h_logits = logits;
+    L.h_ids    = ids;
+    L.h_w      = w;
+    L.norm_w   = norm_w;
+    L.w_scale  = w_scale;
+    hooks[w] = { il, XC_HOOK_DECODE };
+}
+
+bool llama_xcache::eval_cb(ggml_tensor * t, bool ask, void * user_data) {
+    auto * xc = (llama_xcache *) user_data;
+    auto it = xc->hooks.find(t);
+    if (it == xc->hooks.end()) {
+        return !ask;
+    }
+    const int kind = it->second.kind;
+    if (ask) {
+        return kind == XC_HOOK_PREFILL ? (xc->capture_prompt || xc->prefill_stream()) : xc->mode != LLAMA_XC_IDEAL;
+    }
+    if (kind == XC_HOOK_PREFILL) {
+        xc->on_prefill(it->second.il, t);
+    } else {
+        xc->on_decode(it->second.il);
+    }
+    return true;
+}
+
+void llama_xcache::ubatch_done(int n_tokens) {
+    if (n_tokens == 1) {
+        if (opt.sbg && mode != LLAMA_XC_IDEAL && mode != LLAMA_XC_IDEAL_SYNC) {
+            drain();
+        }
+        t_pos += 1;
+        s_tok++;
+    } else {
+        prompt_pos += n_tokens;
+    }
+}
+
+//
+// control
+//
+
+void llama_xcache::begin_prompt() {
+    drain();
+    prompt_pos = 0;
+    capture_prompt = true;
+    for (auto & L : layers) {
+        std::fill(L.prompt_rec.begin(), L.prompt_rec.end(), -1.0);
+        L.prompt_ids.clear();
+    }
+    s_pf_ms   = 0;
+    s_pf_read = 0;
+    s_pf_d2d  = 0;
+    s_pf_ram  = 0;
+    s_pf_used = 0;
+    s_pf_pre  = 0;
+    s_pf_pre_hit = 0;
+    const bool ps = prefill_stream();
+    ef_active = opt.ef || ps;
+    ef_cap    = cap;
+    ef_filled.assign(layers.size(), 0);
+    if (ps && !opt.fresh) {
+        // keep what the pools hold: the prompt pass copies resident experts instead of reading them
+        for (auto & L : layers) {
+            if (L.il >= 0) {
+                poll(L.il);
+            }
+        }
+    } else if (ef_active || opt.fresh) {
+        for (auto & L : layers) {
+            if (L.il < 0) {
+                continue;
+            }
+            L.pend.clear();
+            std::fill(L.state.begin(), L.state.end(), 0);
+            std::fill(L.slot_of.begin(), L.slot_of.end(), -1);
+            std::fill(L.slot_e.begin(), L.slot_e.end(), -1);
+        }
+    }
+    if (opt.pf > 0) {
+        if (!pf_thread.joinable()) {
+            pf_thread = std::thread([this] { pf_worker(); });
+        }
+        std::lock_guard<std::mutex> lk(pf_mtx);
+        pf_on   = true;
+        pf_cur  = -1;
+        pf_next = 0;
+    } else {
+        std::lock_guard<std::mutex> lk(pf_mtx);
+        pf_on = false;
+    }
+    pf_cv.notify_all();
+}
+
+void llama_xcache::pf_worker() {
+    for (;;) {
+        int l;
+        {
+            std::unique_lock<std::mutex> lk(pf_mtx);
+            pf_cv.wait(lk, [&] {
+                return stopping.load() || (pf_on && opt.pf > 0 && pf_next < (int) layers.size() && pf_next <= pf_cur + opt.pf);
+            });
+            if (stopping) {
+                return;
+            }
+            l = pf_next++;
+        }
+        const auto & L = layers[l];
+        if (L.il < 0) {
+            continue;
+        }
+        for (size_t k = 0; k < L.src.size(); ++k) {
+            posix_fadvise(fd_buffered, (off_t) L.foff[k], (off_t) (L.nb2[k] * (size_t) n_expert), POSIX_FADV_WILLNEED);
+        }
+    }
+}
+
+void llama_xcache::evict_host() {
+    drain();
+    const size_t page = (size_t) sysconf(_SC_PAGESIZE);
+    for (auto & L : layers) {
+        if (L.il < 0) {
+            continue;
+        }
+        for (size_t k = 0; k < L.src.size(); ++k) {
+            const size_t len = L.nb2[k] * (size_t) n_expert;
+            const uintptr_t a0 = (uintptr_t) L.src[k]->data / page * page;
+            const uintptr_t a1 = ((uintptr_t) L.src[k]->data + len + page - 1) / page * page;
+            madvise((void *) a0, a1 - a0, MADV_DONTNEED);
+            posix_fadvise(fd_buffered, (off_t) L.foff[k], (off_t) len, POSIX_FADV_DONTNEED);
+        }
+    }
+}
+
+void llama_xcache::on_prefill(int il, ggml_tensor * ids) {
+    auto & L = layers[il];
+    const size_t nb = ggml_nbytes(ids);
+    std::vector<int32_t> buf(nb / sizeof(int32_t) + 1);
+    ggml_backend_tensor_get(ids, buf.data(), 0, nb);
+    std::vector<int> cnt(n_expert, 0);
+    for (int64_t j = 0; j < ids->ne[1]; ++j) {
+        for (int64_t k = 0; k < ids->ne[0]; ++k) {
+            const int32_t e = buf[(j * ids->nb[1] + k * ids->nb[0]) / sizeof(int32_t)];
+            const bool ok = e >= 0 && e < n_expert;
+            if (ok) {
+                cnt[e]++;
+                if (capture_prompt) {
+                    L.prompt_rec[e] = std::max(L.prompt_rec[e], (double) (prompt_pos + j));
+                }
+            }
+            if (capture_prompt && k < n_used) {
+                L.prompt_ids.push_back(ok ? e : -1);
+            }
+        }
+    }
+    if (prefill_stream()) {
+        prefill_load(il, cnt);
+        return;
+    }
+
+    if (opt.pf > 0) {
+        {
+            std::lock_guard<std::mutex> lk(pf_mtx);
+            if (il < pf_cur) {
+                pf_next = il + 1; // next ubatch of the prompt
+            }
+            pf_cur  = il;
+            pf_next = std::max(pf_next, il + 1);
+        }
+        pf_cv.notify_all();
+    }
+    if (ef_active && !ef_filled[il]) {
+        // the prompt routing of this layer is known: start loading its cache now, in the background
+        ef_filled[il] = 1;
+        std::vector<int> order(n_expert);
+        for (int e = 0; e < n_expert; ++e) {
+            order[e] = e;
+        }
+        std::stable_sort(order.begin(), order.end(), [&](int a, int b) { return L.prompt_rec[a] > L.prompt_rec[b]; });
+        for (int s = 0; s < L.cap; ++s) {
+            const int e = order[s];
+            L.state[e]   = 2;
+            L.slot_of[e] = s;
+            L.slot_e[s]  = e;
+            auto j = std::make_shared<llama_xc_job>();
+            j->il = il;
+            j->e = e;
+            j->slot = s;
+            L.pend[e] = j;
+            n_outstanding++;
+            {
+                std::lock_guard<std::mutex> lk(bg_mtx);
+                bg_q.push_back(j);
+            }
+        }
+        bg_cv.notify_all();
+    }
+}
+
+// prompt pass of one layer: put every expert the ubatch uses into the staging area (copy from the pool when
+// resident, read from the file otherwise), then move the layer's decode set into its slots
+void llama_xcache::prefill_load(int il, const std::vector<int> & cnt) {
+    const double t0 = xc_now_ms();
+    auto & L = layers[il];
+    poll(il);
+    wait_prefetch();
+    const bool pre = pre_for == il;
+    pre_for = -1;
+
+    std::vector<utask> tasks;
+    int nu = 0;
+    for (int e = 0; e < n_expert; ++e) {
+        if (cnt[e] == 0) {
+            continue;
+        }
+        nu++;
+        if (pre && pre_have[e]) {
+            s_pf_pre_hit++; // already read ahead
+        } else if (L.state[e] == 1 && L.slot_of[e] >= 0) {
+            tasks.push_back({ il, e, L.slot_of[e], -1, XT_POOL_STAGE });
+        } else {
+            tasks.push_back({ il, e, -1, -1, XT_FILE_STAGE });
+        }
+    }
+    s_pf_used += nu;
+    // file reads first so they start early; copies are cheap
+    std::stable_partition(tasks.begin(), tasks.end(), [](const utask & t) { return t.kind == XT_FILE_STAGE; });
+    run_urgent(tasks);
+
+    if (capture_prompt && ef_active && ef_cap == cap && L.pend.empty()) {
+        // the decode set of this layer (same order as configure): the most recently used experts of the prompt
+        std::vector<int> order(n_expert);
+        for (int e = 0; e < n_expert; ++e) {
+            order[e] = e;
+        }
+        std::stable_sort(order.begin(), order.end(), [&](int a, int b) { return L.prompt_rec[a] > L.prompt_rec[b]; });
+        std::vector<char> in_set(n_expert, 0);
+        for (int s = 0; s < L.cap; ++s) {
+            in_set[order[s]] = 1;
+        }
+        std::vector<int> free_slots;
+        for (int s = 0; s < L.cap; ++s) {
+            const int e = L.slot_e[s];
+            if (e < 0 || L.state[e] != 1 || !in_set[e]) {
+                free_slots.push_back(s);
+            }
+        }
+        std::vector<utask> fill;
+        size_t fi = 0;
+        for (int i = 0; i < L.cap; ++i) {
+            const int e = order[i];
+            if (L.state[e] == 1 && L.slot_of[e] >= 0 && L.slot_of[e] < L.cap) {
+                continue; // resident
+            }
+            if (cnt[e] == 0) {
+                continue; // not in the staging area: configure loads it
+            }
+            GGML_ASSERT(fi < free_slots.size());
+            const int s = free_slots[fi++];
+            const int v = L.slot_e[s];
+            if (v >= 0) {
+                L.state[v]   = 0;
+                L.slot_of[v] = -1;
+            }
+            if (L.slot_of[e] >= 0) {
+                L.slot_e[L.slot_of[e]] = -1; // resident above cap (older, larger configuration)
+            }
+            L.slot_e[s]  = e;
+            L.slot_of[e] = s;
+            L.state[e]   = 1;
+            fill.push_back({ il, e, s, -1, XT_STAGE_POOL });
+        }
+        run_urgent(fill);
+        ef_filled[il] = 1;
+    }
+
+    if (opt.pso > 0 && nu >= opt.pso * n_expert) {
+        // dense layer: the next one is likely dense too, read its non-resident experts while the device computes
+        int jn = il + 1;
+        while (jn < (int) layers.size() && layers[jn].il < 0) {
+            jn++;
+        }
+        if (jn < (int) layers.size()) {
+            auto & N = layers[jn];
+            poll(jn);
+            pre_have.assign(n_expert, 0);
+            auto b = std::make_shared<ubatch>();
+            for (int e = 0; e < n_expert; ++e) {
+                if (!(N.state[e] == 1 && N.slot_of[e] >= 0)) {
+                    b->tasks.push_back({ jn, e, -1, -1, XT_FILE_STAGE });
+                    pre_have[e] = 1;
+                }
+            }
+            if (!b->tasks.empty()) {
+                s_pf_pre += (int64_t) b->tasks.size();
+                b->left = (int) b->tasks.size();
+                {
+                    std::lock_guard<std::mutex> lk(u_mtx);
+                    u_cur = b;
+                    u_gen++;
+                }
+                u_cv.notify_all();
+                pre_b   = b;
+                pre_for = jn;
+            }
+        }
+    }
+    s_pf_ms += xc_now_ms() - t0;
+}
+
+void llama_xcache::set_opts(const char * str) {
+    opt = llama_xc_opts();
+    std::string s = str ? str : "";
+    size_t p = 0;
+    while (p < s.size()) {
+        size_t q = s.find('+', p);
+        if (q == std::string::npos) {
+            q = s.size();
+        }
+        const std::string kv = s.substr(p, q - p);
+        p = q + 1;
+        const size_t eq = kv.find('=');
+        if (kv.empty() || eq == std::string::npos) {
+            continue;
+        }
+        const std::string k = kv.substr(0, eq);
+        const double v = atof(kv.c_str() + eq + 1);
+        if      (k == "aio") { opt.aio   = v != 0; }
+        else if (k == "uf")  { opt.uf    = v != 0; }
+        else if (k == "up")  { opt.upart = v != 0; }
+        else if (k == "adm") { opt.adm   = v != 0; }
+        else if (k == "sbg") { opt.sbg   = v != 0; }
+        else if (k == "lam") { opt.lam   = v; }
+        else if (k == "bg")  { opt.bg    = v != 0; }
+        else if (k == "pf")  { opt.pf    = (int) v; }
+        else if (k == "ef")  { opt.ef    = v != 0; }
+        else if (k == "ps")  { opt.ps    = v != 0; }
+        else if (k == "fresh") { opt.fresh = v != 0; }
+        else if (k == "pso") { opt.pso   = v; }
+        else if (k == "ram") { opt.ram   = (int) v; }
+        else if (k == "ramthr") { opt.ramthr = v; }
+        else if (k == "fe")  { opt.fe    = v; }
+        else if (k == "dk")  { opt.dk    = v != 0; }
+        else if (k == "rb")  { opt.rb    = v; }
+        else if (k == "rh")  { opt.rh    = v; }
+        else if (k == "rq")  { opt.rq    = (int) v; }
+        else {
+            LLAMA_LOG_WARN("%s: unknown option '%s'\n", __func__, k.c_str());
+        }
+    }
+    if (opt.fe > 0 && opt.fe < 1) {
+        opt.lam = -std::log2(1.0 - opt.fe);
+    } else {
+        opt.fe = 0;
+    }
+    if (opt.rh <= 0) {
+        opt.rh = 512.0;
+    }
+    if (opt.ps && !alloc_stage()) {
+        opt.ps = false;
+    }
+    ram_on = opt.ram == 1;
+    if (opt.ram == 2) {
+        ram_frac = resident_frac();
+        ram_on   = ram_frac >= opt.ramthr;
+        LLAMA_LOG_INFO("%s: ram auto: %.1f%% of the expert pages resident -> %s\n", __func__, 100.0 * ram_frac, ram_on ? "on" : "off");
+    }
+}
+
+double llama_xcache::resident_frac() {
+    static const size_t page = (size_t) sysconf(_SC_PAGESIZE);
+    size_t n_in = 0;
+    size_t n_all = 0;
+    int ord = 0;
+    for (const auto & L : layers) {
+        if (L.il < 0 || (ord++ % 4) != 0) {
+            continue;
+        }
+        for (const ggml_tensor * t : L.src) {
+            const uintptr_t a0 = (uintptr_t) t->data / page * page;
+            const uintptr_t a1 = ((uintptr_t) t->data + ggml_nbytes(t) + page - 1) / page * page;
+            mc_vec.resize((a1 - a0) / page);
+            if (mincore((void *) a0, a1 - a0, mc_vec.data()) != 0) {
+                return 0.0;
+            }
+            for (unsigned char v : mc_vec) {
+                n_in += v & 1;
+            }
+            n_all += mc_vec.size();
+        }
+    }
+    return n_all ? (double) n_in / (double) n_all : 0.0;
+}
+
+int llama_xcache::configure(int mode_, float frac, int src_, float tau_) {
+    drain();
+    {
+        std::lock_guard<std::mutex> lk(pf_mtx);
+        pf_on = false;
+    }
+    mode = mode_;
+    src  = src_;
+    tau  = tau_;
+    cap  = std::min(cap_max, std::max(n_used + 1, (int) std::lround(frac * n_expert)));
+    const bool reuse = ef_active && ef_cap == cap;
+    ef_active = false;
+
+    std::vector<utask> tasks;
+    for (auto & L : layers) {
+        if (L.il < 0) {
+            continue;
+        }
+        poll(L.il);
+        L.cap = std::min(L.cap_max, std::max(n_used + 1, (int) std::lround((double) L.cap_max * cap / cap_max)));
+        const std::vector<int8_t>  old_state   = L.state;
+        const std::vector<int32_t> old_slot_of = L.slot_of;
+        const bool keep = reuse && L.il < (int) ef_filled.size() && ef_filled[L.il];
+        L.pend.clear();
+        std::fill(L.state.begin(), L.state.end(), 0);
+        std::fill(L.slot_of.begin(), L.slot_of.end(), -1);
+        std::fill(L.slot_e.begin(), L.slot_e.end(), -1);
+        std::fill(L.rv.begin(), L.rv.end(), 0.0);
+        std::fill(L.rt.begin(), L.rt.end(), 0.0);
+        L.rec = L.prompt_rec;
+        if (opt.fe > 0) {
+            // frequency score key = log2(sum over uses of 2^(lam * position)), from every use of the prompt
+            for (int e = 0; e < n_expert; ++e) {
+                L.rec[e] = -1e30;
+            }
+            for (size_t i = 0; i < L.prompt_ids.size(); ++i) {
+                const int e = L.prompt_ids[i];
+                if (e < 0) {
+                    continue;
+                }
+                const double x = opt.lam * (double) (i / n_used);
+                double & k = L.rec[e];
+                k = k < -1e29 ? x : std::max(k, x) + std::log2(1.0 + std::exp2(-std::fabs(k - x)));
+            }
+        } else if (opt.lam > 0) {
+            // LRFU key = log2(score) + lam * t_last; a prompt use counts as one use at its last position
+            for (int e = 0; e < n_expert; ++e) {
+                L.rec[e] = L.prompt_rec[e] >= 0 ? opt.lam * L.prompt_rec[e] : -1e30;
+            }
+        }
+
+        // initial set: most recently used experts of the prompt (option fe: best frequency scores)
+        std::vector<int> order(n_expert);
+        for (int e = 0; e < n_expert; ++e) {
+            order[e] = e;
+        }
+        const std::vector<double> & okey = opt.fe > 0 ? L.rec : L.prompt_rec;
+        std::stable_sort(order.begin(), order.end(), [&](int a, int b) { return okey[a] > okey[b]; });
+        std::vector<char> used(L.cap, 0);
+        std::vector<int>  todo;
+        for (int s = 0; s < L.cap; ++s) {
+            const int e = order[s];
+            const int os = keep && old_state[e] == 1 ? old_slot_of[e] : -1;
+            if (os >= 0 && os < L.cap && !used[os]) {
+                // already loaded during the prefill
+                used[os]     = 1;
+                L.state[e]   = 1;
+                L.slot_of[e] = os;
+                L.slot_e[os] = e;
+            } else {
+                todo.push_back(e);
+            }
+        }
+        int f = 0;
+        for (int e : todo) {
+            while (used[f]) {
+                f++;
+            }
+            used[f]      = 1;
+            L.state[e]   = 1;
+            L.slot_of[e] = f;
+            L.slot_e[f]  = e;
+            tasks.push_back({ L.il, e, f });
+        }
+    }
+    const int saved_src = src;
+    src = LLAMA_XC_SRC_NVME;
+    for (size_t i = 0; i < tasks.size(); i += 256) {
+        std::vector<utask> part(tasks.begin() + i, tasks.begin() + std::min(tasks.size(), i + 256));
+        run_urgent(part);
+    }
+    src = saved_src;
+
+    for (auto & L : layers) {
+        if (L.il < 0) {
+            continue;
+        }
+        for (int e = 0; e < n_expert; ++e) {
+            if (mode == LLAMA_XC_IDEAL || mode == LLAMA_XC_IDEAL_SYNC) {
+                L.slot_map_host[e] = e % L.cap;
+            } else {
+                L.slot_map_host[e] = L.slot_of[e] >= 0 ? L.slot_of[e] : 0;
+            }
+        }
+        ggml_backend_tensor_set(L.slot_map, L.slot_map_host.data(), 0, sizeof(int32_t) * n_expert);
+        L.dirty = false;
+    }
+
+    t_pos = prompt_pos;
+    capture_prompt = false;
+    if (trace) {
+        for (const auto & L : layers) {
+            if (L.il < 0) {
+                continue;
+            }
+            fprintf(trace, "CFG %d %d %.0f %d %.9g %.17g %d %.17g %.17g %d %d\n", L.il, L.cap, t_pos, mode, tau, opt.lam, (int) opt.dk,
+                    opt.rb, opt.rh, opt.rq, (int) opt.sbg);
+            fprintf(trace, "S");
+            for (int s = 0; s < L.cap; ++s) {
+                fprintf(trace, " %d", L.slot_e[s]);
+            }
+            fprintf(trace, "\nR");
+            for (int e = 0; e < n_expert; ++e) {
+                fprintf(trace, " %.17g", L.rec[e]);
+            }
+            fprintf(trace, "\nP");
+            for (int x : L.prompt_ids) {
+                fprintf(trace, " %d", x);
+            }
+            fprintf(trace, "\n");
+        }
+    }
+    s_stall_ms = s_wait_pending_ms = s_cb_ms = s_mass = 0;
+    s_tok = s_want = s_hit = s_sub = s_urg = s_cancel = s_drop = s_steal = s_skip = s_ltok = 0;
+    s_bg = 0;
+    s_bytes = 0;
+    return 0;
+}
+
+void llama_xcache::get_stats(llama_xcache_stats * out) const {
+    out->stall_ms        = s_stall_ms;
+    out->wait_pending_ms = s_wait_pending_ms;
+    out->cb_ms           = s_cb_ms;
+    out->n_tok    = s_tok;
+    out->n_want   = s_want;
+    out->n_hit    = s_hit;
+    out->n_sub    = s_sub;
+    out->n_urg    = s_urg;
+    out->n_bg     = s_bg.load();
+    out->n_cancel = s_cancel;
+    out->n_drop   = s_drop;
+    out->n_steal  = s_steal;
+    out->n_skip   = s_skip;
+    out->bytes    = s_bytes.load();
+    out->pf_ms         = s_pf_ms;
+    out->pf_read_bytes = s_pf_read.load();
+    out->pf_d2d_bytes  = s_pf_d2d.load();
+    out->pf_ram_bytes  = s_pf_ram.load();
+    out->pf_used       = s_pf_used;
+    out->pf_pre        = s_pf_pre;
+    out->pf_pre_hit    = s_pf_pre_hit;
+    out->ram_frac      = ram_frac;
+    out->ram_on        = ram_on ? 1 : 0;
+    out->mass          = s_mass;
+    out->n_ltok        = s_ltok;
+}
+
+//
+// loading
+//
+
+const uint8_t * llama_xcache::read_tensor_part(int il, int k, int e, uint8_t * dst) {
+    const auto & L = layers[il];
+    const size_t   len = L.nb2[k];
+    const uint64_t off = L.foff[k] + (uint64_t) e * len;
+    if (fd_direct >= 0) {
+        const uint64_t a0 = off / XC_ALIGN * XC_ALIGN;
+        const uint64_t a1 = (off + len + XC_ALIGN - 1) / XC_ALIGN * XC_ALIGN;
+        size_t got = 0;
+        while (got < a1 - a0) {
+            const ssize_t r = pread(fd_direct, dst + got, (a1 - a0) - got, a0 + got);
+            if (r <= 0) {
+                throw std::runtime_error("xcache: read failed");
+            }
+            got += r;
+        }
+        return dst + (off - a0);
+    }
+    size_t got = 0;
+    while (got < len) {
+        const ssize_t r = pread(fd_buffered, dst + got, len - got, off + got);
+        if (r <= 0) {
+            throw std::runtime_error("xcache: read failed");
+        }
+        got += r;
+    }
+    posix_fadvise(fd_buffered, off, len, POSIX_FADV_DONTNEED);
+    return dst;
+}
+
+// true when every page of [p, p + n) is in memory (page cache for file mappings)
+bool llama_xcache::resident(const void * p, size_t n) {
+    static const size_t page = (size_t) sysconf(_SC_PAGESIZE);
+    const uintptr_t a0 = (uintptr_t) p / page * page;
+    const uintptr_t a1 = ((uintptr_t) p + n + page - 1) / page * page;
+    thread_local std::vector<unsigned char> vec;
+    vec.resize((a1 - a0) / page);
+    if (mincore((void *) a0, a1 - a0, vec.data()) != 0) {
+        return false;
+    }
+    for (unsigned char v : vec) {
+        if (!(v & 1)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+// device to device copy of a byte range (both tensors in device buffers of the pool device)
+void llama_xcache::d2d(ggml_tensor * a, size_t a_off, ggml_tensor * b, size_t b_off, size_t n) {
+    ggml_tensor ta{};
+    ggml_tensor tb{};
+    for (ggml_tensor * t : { &ta, &tb }) {
+        t->type  = GGML_TYPE_I8;
+        t->ne[0] = (int64_t) n;
+        t->ne[1] = t->ne[2] = t->ne[3] = 1;
+        t->nb[0] = 1;
+        t->nb[1] = t->nb[2] = t->nb[3] = n;
+    }
+    ta.buffer = a->buffer;
+    ta.data   = (uint8_t *) a->data + a_off;
+    tb.buffer = b->buffer;
+    tb.data   = (uint8_t *) b->data + b_off;
+    ggml_backend_tensor_copy(&ta, &tb);
+}
+
+void llama_xcache::load_part(int il, int e, int slot, int k, uint8_t * stg, int kind) {
+    const auto & L = layers[il];
+    const size_t nb = L.nb2[k];
+    if (kind == XT_POOL_STAGE) {
+        d2d(L.pool[k], (size_t) slot * nb, L.stg[k], (size_t) e * nb, nb);
+        s_pf_d2d += (int64_t) nb;
+        return;
+    }
+    if (kind == XT_STAGE_POOL) {
+        d2d(L.stg[k], (size_t) e * nb, L.pool[k], (size_t) slot * nb, nb);
+        s_pf_d2d += (int64_t) nb;
+        return;
+    }
+    const uint8_t * host = (const uint8_t *) L.src[k]->data + (size_t) e * nb;
+    const uint8_t * data;
+    bool from_ram = false;
+    if (src == LLAMA_XC_SRC_RAM) {
+        data = host;
+        from_ram = true;
+    } else if (ram_on && resident(host, nb)) {
+        // in the page cache: copy into pinned staging (faster than reading the file again)
+        memcpy(stg, host, nb);
+        data = stg;
+        from_ram = true;
+    } else {
+        data = read_tensor_part(il, k, e, stg);
+    }
+    if (kind == XT_FILE_STAGE) {
+        ggml_backend_tensor_set(L.stg[k], data, (size_t) e * nb, nb);
+        (from_ram ? s_pf_ram : s_pf_read) += (int64_t) nb;
+    } else {
+        ggml_backend_tensor_set(L.pool[k], data, (size_t) slot * nb, nb);
+        s_bytes += (int64_t) nb;
+    }
+}
+
+void llama_xcache::load_expert(int il, int e, int slot, uint8_t * stg, bool yield_to_urgent, int kind) {
+    const auto & L = layers[il];
+    uint8_t * p = stg;
+    for (size_t k = 0; k < L.src.size(); ++k) {
+        if (yield_to_urgent) {
+            while (urg_active.load() > 0) {
+                std::this_thread::sleep_for(std::chrono::microseconds(20));
+            }
+        }
+        load_part(il, e, slot, (int) k, p, kind);
+        p += (L.nb2[k] + 2 * XC_ALIGN) / XC_ALIGN * XC_ALIGN;
+    }
+}
+
+void llama_xcache::run_task(const utask & tk, uint8_t * stg) {
+    if (tk.part < 0) {
+        load_expert(tk.il, tk.e, tk.slot, stg, false, tk.kind);
+    } else {
+        load_part(tk.il, tk.e, tk.slot, tk.part, stg, tk.kind);
+    }
+}
+
+void llama_xcache::u_worker(int wid) {
+    int seen = 0;
+    for (;;) {
+        std::shared_ptr<ubatch> b;
+        {
+            std::unique_lock<std::mutex> lk(u_mtx);
+            u_cv.wait(lk, [&] { return u_gen != seen; });
+            seen = u_gen;
+            if (stopping) {
+                return;
+            }
+            b = u_cur;
+        }
+        for (;;) {
+            const int i = b->next.fetch_add(1);
+            if (i >= (int) b->tasks.size()) {
+                break;
+            }
+            run_task(b->tasks[i], stage(wid));
+            if (b->left.fetch_sub(1) == 1) {
+                std::lock_guard<std::mutex> lk(u_mtx);
+                u_done_cv.notify_all();
+            }
+        }
+    }
+}
+
+void llama_xcache::run_urgent(const std::vector<utask> & tasks_in) {
+    if (tasks_in.empty()) {
+        return;
+    }
+    std::vector<utask> tasks;
+    if (opt.upart) {
+        for (const auto & tk : tasks_in) {
+            for (int k = 0; k < (int) layers[tk.il].src.size(); ++k) {
+                tasks.push_back({ tk.il, tk.e, tk.slot, k, tk.kind });
+            }
+        }
+    } else {
+        tasks = tasks_in;
+    }
+    if (opt.uf) {
+        urg_active++;
+    }
+    uint8_t * stg_main = stage(XC_N_URG + XC_N_BG);
+    if (tasks.size() == 1) {
+        run_task(tasks[0], stg_main);
+    } else {
+        auto b = std::make_shared<ubatch>();
+        b->tasks = tasks;
+        b->left  = (int) tasks.size();
+        {
+            std::lock_guard<std::mutex> lk(u_mtx);
+            u_cur = b;
+            u_gen++;
+        }
+        u_cv.notify_all();
+        // the main thread takes tasks too
+        for (;;) {
+            const int i = b->next.fetch_add(1);
+            if (i >= (int) b->tasks.size()) {
+                break;
+            }
+            run_task(b->tasks[i], stg_main);
+            if (b->left.fetch_sub(1) == 1) {
+                std::lock_guard<std::mutex> lk(u_mtx);
+                u_done_cv.notify_all();
+            }
+        }
+        std::unique_lock<std::mutex> lk(u_mtx);
+        u_done_cv.wait(lk, [&] { return b->left.load() == 0; });
+    }
+    if (opt.uf) {
+        urg_active--;
+    }
+}
+
+void llama_xcache::bg_worker(int wid) {
+    for (;;) {
+        std::shared_ptr<llama_xc_job> j;
+        {
+            std::unique_lock<std::mutex> lk(bg_mtx);
+            bg_cv.wait(lk, [&] { return stopping || !bg_q.empty(); });
+            if (bg_q.empty()) {
+                return;
+            }
+            j = bg_q.front();
+            bg_q.pop_front();
+        }
+        int exp = XC_QUEUED;
+        if (j->st.compare_exchange_strong(exp, XC_RUNNING)) {
+            load_expert(j->il, j->e, j->slot, stage(XC_N_URG + wid), opt.uf);
+            s_bg++;
+            {
+                std::lock_guard<std::mutex> lk(done_mtx);
+                j->st = XC_DONE;
+            }
+            done_cv.notify_all();
+        }
+        n_outstanding--;
+        {
+            std::lock_guard<std::mutex> lk(done_mtx);
+        }
+        done_cv.notify_all();
+    }
+}
+
+void llama_xcache::wait_prefetch() {
+    if (!pre_b) {
+        return;
+    }
+    {
+        std::unique_lock<std::mutex> lk(u_mtx);
+        u_done_cv.wait(lk, [&] { return pre_b->left.load() == 0; });
+    }
+    pre_b.reset();
+}
+
+void llama_xcache::drain() {
+    wait_prefetch();
+    pre_for = -1;
+    std::unique_lock<std::mutex> lk(done_mtx);
+    done_cv.wait(lk, [&] { return n_outstanding.load() == 0; });
+}
+
+//
+// routing
+//
+
+void llama_xcache::poll(int il) {
+    auto & L = layers[il];
+    for (auto it = L.pend.begin(); it != L.pend.end();) {
+        if (it->second->st.load() == XC_DONE) {
+            L.state[it->first] = 1;
+            it = L.pend.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+int llama_xcache::victim(int il, const std::vector<char> & prot) const {
+    const auto & L = layers[il];
+    int best = -1;
+    double best_rec = 0;
+    for (int s = 0; s < L.cap; ++s) {
+        const int e = L.slot_e[s];
+        if (e < 0 || L.state[e] != 1 || prot[e]) {
+            continue;
+        }
+        if (best < 0 || L.rec[e] < best_rec) {
+            best = e;
+            best_rec = L.rec[e];
+        }
+    }
+    return best;
+}
+
+int llama_xcache::assign(int il, int v, int e) {
+    auto & L = layers[il];
+    const int s = L.slot_of[v];
+    L.slot_of[v] = -1;
+    L.state[v]   = 0;
+    L.slot_of[e] = s;
+    L.slot_e[s]  = e;
+    L.slot_map_host[e] = s;
+    L.dirty = true;
+    return s;
+}
+
+int llama_xcache::claim(int il, int e) {
+    auto & L = layers[il];
+    auto j = L.pend[e];
+    L.pend.erase(e);
+    int exp = XC_QUEUED;
+    if (j->st.compare_exchange_strong(exp, XC_CANCELLED)) {
+        s_cancel++;
+        return j->slot;
+    }
+    const double t0 = xc_now_ms();
+    {
+        std::unique_lock<std::mutex> lk(done_mtx);
+        done_cv.wait(lk, [&] { return j->st.load() == XC_DONE; });
+    }
+    s_wait_pending_ms += xc_now_ms() - t0;
+    return -1;
+}
+
+int llama_xcache::slot_for_must(int il, int e, const std::vector<char> & prot, const std::vector<char> & psel) {
+    auto & L = layers[il];
+    int v = victim(il, prot);
+    if (v >= 0) {
+        return assign(il, v, e);
+    }
+    s_steal++;
+    if (L.pend.empty()) {
+        v = victim(il, psel);
+        GGML_ASSERT(v >= 0 && "xcache: no evictable slot");
+        return assign(il, v, e);
+    }
+    const int pe = L.pend.begin()->first;
+    auto j = L.pend.begin()->second;
+    L.pend.erase(L.pend.begin());
+    int exp = XC_QUEUED;
+    if (!j->st.compare_exchange_strong(exp, XC_CANCELLED)) {
+        std::unique_lock<std::mutex> lk(done_mtx);
+        done_cv.wait(lk, [&] { return j->st.load() == XC_DONE; });
+    }
+    L.state[pe] = 1;
+    return assign(il, pe, e);
+}
+
+void llama_xcache::touch(llama_xc_layer & L, int e) {
+    if (opt.lam <= 0) {
+        L.rec[e] = t_pos;
+        return;
+    }
+    const double k  = L.rec[e];
+    const double sc = k < -1e29 ? 0.0 : std::exp2(k - opt.lam * t_pos);
+    L.rec[e] = std::log2(sc + 1.0) + opt.lam * t_pos;
+}
+
+// small copies between the host and a graph tensor; async on the compute stream when opt.aio
+void llama_xcache::dev_get(ggml_tensor * t, void * dst, size_t n) {
+    ggml_backend_buffer_t buf = t->view_src ? t->view_src->buffer : t->buffer;
+    if (opt.aio && be && !ggml_backend_buffer_is_host(buf)) {
+        ggml_backend_tensor_get_async(be, t, dst, 0, n);
+    } else {
+        ggml_backend_tensor_get(t, dst, 0, n);
+    }
+}
+
+void llama_xcache::dev_set(ggml_tensor * t, const void * src_p, size_t n) {
+    ggml_backend_buffer_t buf = t->view_src ? t->view_src->buffer : t->buffer;
+    if (opt.aio && be && !ggml_backend_buffer_is_host(buf)) {
+        ggml_backend_tensor_set_async(be, t, src_p, 0, n);
+    } else {
+        ggml_backend_tensor_set(t, src_p, 0, n);
+    }
+}
+
+void llama_xcache::on_decode(int il) {
+    const double t_cb0 = xc_now_ms();
+    auto & L = layers[il];
+    const int E = n_expert;
+    const int K = n_used;
+
+    // wanted set = the router top-K computed on the device (sorted by weight)
+    const bool aio = opt.aio && be;
+    bool have_z = false;
+    if (aio) {
+        // ids and logits in one round trip
+        dev_get(L.h_ids, L.io_gids, sizeof(int32_t) * K);
+        if (mode != LLAMA_XC_IDEAL_SYNC) {
+            dev_get(L.h_logits, L.io_gz, sizeof(float) * E);
+            have_z = true;
+        }
+        ggml_backend_synchronize(be);
+    } else {
+        ggml_backend_tensor_get(L.h_ids, L.io_gids, 0, sizeof(int32_t) * K);
+    }
+    if (mode == LLAMA_XC_IDEAL_SYNC) {
+        s_cb_ms += xc_now_ms() - t_cb0;
+        return;
+    }
+    std::vector<int> wi(L.io_gids, L.io_gids + K);
+
+    poll(il);
+    std::vector<char> hit(K);
+    int nh = 0;
+    for (int k = 0; k < K; ++k) {
+        hit[k] = L.state[wi[k]] == 1;
+        nh += hit[k];
+    }
+    s_want += K;
+    s_hit  += nh;
+    s_ltok++;
+
+    if (nh == K) {
+        // all resident: device ids and weights are already right
+        if (trace) {
+            fprintf(trace, "H %d %.0f", il, t_pos);
+            for (int e : wi) {
+                fprintf(trace, " %d", e);
+            }
+            fprintf(trace, "\n");
+        }
+        for (int e : wi) {
+            touch(L, e);
+        }
+        if (L.dirty) {
+            memcpy(L.io_map, L.slot_map_host.data(), sizeof(int32_t) * E);
+            dev_set(L.slot_map, L.io_map, sizeof(int32_t) * E);
+            L.dirty = false;
+        }
+        s_cb_ms += xc_now_ms() - t_cb0;
+        return;
+    }
+
+    if (!have_z) {
+        ggml_backend_tensor_get(L.h_logits, L.io_gz, 0, sizeof(float) * E);
+    }
+    const float * z = L.io_gz;
+
+    std::vector<int> must, bgm;
+    std::vector<double> bgp; // normalized gate weight of each substituted miss
+    std::vector<int> sel = wi;
+    {
+        // normalized gate weights of the wanted set (softmax over the selected logits)
+        std::vector<double> p(K);
+        double sum = 0;
+        for (int k = 0; k < K; ++k) {
+            p[k] = std::exp((double) z[wi[k]] - z[wi[0]]);
+            sum += p[k];
+        }
+        for (int k = 0; k < K; ++k) {
+            if (hit[k]) {
+                continue;
+            }
+            bool wait = false;
+            if (mode == LLAMA_XC_EXACT) {
+                wait = true;
+            } else if (mode == LLAMA_XC_C) {
+                wait = k == 0 || p[k] / sum >= tau;
+            }
+            if (wait) {
+                must.push_back(wi[k]);
+            } else {
+                bgm.push_back(wi[k]);
+                bgp.push_back(p[k] / sum);
+                s_mass += p[k] / sum;
+            }
+        }
+        if (!bgm.empty()) {
+            // top-K among resident experts and the ones we wait for
+            std::vector<int> cand;
+            cand.reserve(E);
+            for (int e = 0; e < E; ++e) {
+                if (L.state[e] == 1) {
+                    cand.push_back(e);
+                }
+            }
+            for (int e : must) {
+                cand.push_back(e);
+            }
+            const int kk = std::min(K, (int) cand.size());
+            std::partial_sort(cand.begin(), cand.begin() + kk, cand.end(), [&](int a, int b) { return z[a] > z[b] || (z[a] == z[b] && a < b); });
+            sel.assign(cand.begin(), cand.begin() + kk);
+            while ((int) sel.size() < K) {
+                sel.push_back(sel.back());
+            }
+        }
+    }
+
+    for (int e : wi) {
+        touch(L, e);
+    }
+    if (!opt.dk) {
+        for (int e : sel) {
+            if (std::find(wi.begin(), wi.end(), e) == wi.end()) {
+                touch(L, e);
+            }
+        }
+    }
+
+    std::vector<char> psel(E, 0);
+    for (int e : sel) {
+        psel[e] = 1;
+    }
+    for (int e : must) {
+        psel[e] = 1;
+    }
+    std::vector<char> prot = psel;
+    for (int e : wi) {
+        prot[e] = 1;
+    }
+
+    const double t0 = xc_now_ms();
+    std::vector<utask> urg;
+    for (int e : must) {
+        if (L.pend.count(e)) {
+            const int s = claim(il, e);
+            if (s >= 0) {
+                urg.push_back({ il, e, s });
+            }
+        } else {
+            urg.push_back({ il, e, slot_for_must(il, e, prot, psel) });
+        }
+        L.state[e] = 1;
+    }
+    run_urgent(urg);
+    s_urg += (int64_t) urg.size();
+    s_stall_ms += xc_now_ms() - t0;
+
+    std::vector<int> sched_log;
+    const int lim = std::max(L.cap - 3 * K, L.cap / 4);
+    const double rlam = std::log(2.0) / opt.rh;
+    for (size_t ib = 0; ib < bgm.size(); ++ib) {
+        const int e = bgm[ib];
+        if (L.pend.count(e)) {
+            continue;
+        }
+        int v = -1;
+        if (opt.rb > 0) {
+            // rent-or-buy: each substitution loses the expert's gate weight; once the decayed loss reaches rb, buy it
+            const double r = L.rv[e] * std::exp(-rlam * (t_pos - L.rt[e])) + bgp[ib];
+            L.rt[e] = t_pos;
+            L.rv[e] = r;
+            if (r < opt.rb) {
+                s_skip++;
+                continue;
+            }
+            v = (int) L.pend.size() < std::min(lim, opt.rq) ? victim(il, prot) : -1;
+            if (v < 0) {
+                s_drop++; // keeps its account, tried again at its next substitution
+                continue;
+            }
+            L.rv[e] = 0;
+        } else {
+            if (!opt.bg) {
+                s_skip++;
+                continue;
+            }
+            v = (int) L.pend.size() < lim ? victim(il, prot) : -1;
+            if (v < 0) {
+                s_drop++;
+                continue;
+            }
+            if (opt.adm && L.rec[e] < L.rec[v]) {
+                // not admitted: its recent use is below the victim's, keep substituting
+                s_skip++;
+                continue;
+            }
+        }
+        if (trace) {
+            sched_log.push_back(e);
+            sched_log.push_back(v);
+        }
+        const int s = assign(il, v, e);
+        L.state[e] = 2;
+        auto j = std::make_shared<llama_xc_job>();
+        j->il = il;
+        j->e = e;
+        j->slot = s;
+        L.pend[e] = j;
+        n_outstanding++;
+        {
+            std::lock_guard<std::mutex> lk(bg_mtx);
+            bg_q.push_back(j);
+        }
+        bg_cv.notify_one();
+    }
+
+    for (int e : sel) {
+        if (std::find(wi.begin(), wi.end(), e) == wi.end()) {
+            s_sub++;
+        }
+    }
+    if (trace) {
+        auto lst = [&](const char * tag, const std::vector<int> & v) {
+            fprintf(trace, " %s", tag);
+            for (int x : v) {
+                fprintf(trace, " %d", x);
+            }
+        };
+        fprintf(trace, "D %d %.0f", il, t_pos);
+        lst("W", wi);
+        lst("M", must);
+        lst("B", bgm);
+        lst("G", sched_log);
+        lst("L", sel);
+        fprintf(trace, " Z");
+        for (int e = 0; e < E; ++e) {
+            fprintf(trace, " %.9g", z[e]);
+        }
+        fprintf(trace, "\n");
+    }
+
+    const bool changed = sel != wi;
+    if (changed) {
+        // weights of the final selection
+        double m = -INFINITY;
+        for (int e : sel) {
+            m = std::max(m, (double) z[e]);
+        }
+        std::vector<double> ex(K);
+        double denom = 0;
+        for (int k = 0; k < K; ++k) {
+            ex[k] = std::exp((double) z[sel[k]] - m);
+            denom += ex[k];
+        }
+        if (!L.norm_w) {
+            double zm = -INFINITY;
+            for (int e = 0; e < E; ++e) {
+                zm = std::max(zm, (double) z[e]);
+            }
+            denom = 0;
+            for (int e = 0; e < E; ++e) {
+                denom += std::exp((double) z[e] - zm);
+            }
+            for (int k = 0; k < K; ++k) {
+                ex[k] = std::exp((double) z[sel[k]] - zm);
+            }
+        }
+        const float sc = (L.w_scale != 0.0f) ? L.w_scale : 1.0f;
+        for (int k = 0; k < K; ++k) {
+            L.io_w[k]   = (float) (ex[k] / denom) * sc;
+            L.io_ids[k] = sel[k];
+        }
+        dev_set(L.h_ids, L.io_ids, sizeof(int32_t) * K);
+        dev_set(L.h_w, L.io_w, sizeof(float) * K);
+    }
+    if (L.dirty) {
+        memcpy(L.io_map, L.slot_map_host.data(), sizeof(int32_t) * E);
+        dev_set(L.slot_map, L.io_map, sizeof(int32_t) * E);
+        L.dirty = false;
+    }
+
+    s_cb_ms += xc_now_ms() - t_cb0;
+}
diff --git a/src/llama-xcache.h b/src/llama-xcache.h
new file mode 100644
index 0000000..b5b1398
--- /dev/null
+++ b/src/llama-xcache.h
@@ -0,0 +1,264 @@
+#pragma once
+
+// Expert cache for MoE decode (experimental, env LLAMA_XCACHE=1).
+// Each MoE layer keeps a small pool of expert slots in device memory. The router still picks
+// the experts, but on a miss the cache can wait for the load (exact), wait only for the rank-1
+// expert (C with tau > 1), wait for rank-1 or heavy experts (C), or never wait (B). Experts that
+// are not waited for are replaced by the best resident experts and loaded in the background.
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <atomic>
+#include <cstdio>
+#include <condition_variable>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+
+struct llama_model;
+struct llama_xcache_stats;
+
+enum llama_xc_mode {
+    LLAMA_XC_IDEAL = 0, // no host round trip, fixed slot map (upper bound, outputs not meaningful)
+    LLAMA_XC_IDEAL_SYNC,
+    LLAMA_XC_EXACT,
+    LLAMA_XC_C,
+    LLAMA_XC_B,
+};
+
+enum llama_xc_src {
+    LLAMA_XC_SRC_NVME = 0, // O_DIRECT reads from the GGUF file
+    LLAMA_XC_SRC_RAM,      // copy from the host tensor (mmap / page cache)
+};
+
+struct llama_xc_job;
+
+struct llama_xc_layer {
+    int il = -1;
+    std::vector<ggml_tensor *> src;   // host expert tensors
+    std::vector<ggml_tensor *> pool;  // device slot pools, same type, ne[2] = cap_max
+    std::vector<ggml_tensor *> stg;   // device staging for prompt processing, full layer layout (MoE layers alternate between two areas)
+    std::vector<size_t>        nb2;   // bytes per expert per tensor
+    std::vector<uint64_t>      foff;  // file offset of the tensor data
+    ggml_tensor * slot_map = nullptr; // I32 [1, n_expert]
+
+    int cap_max = 0; // slots in the pools of this layer
+    int cap     = 0; // slots in use (configure)
+
+    std::vector<int8_t>  state;   // 0 absent, 1 resident, 2 loading
+    std::vector<int32_t> slot_of;
+    std::vector<int32_t> slot_e;
+    std::vector<double>  rec;
+    std::vector<double>  prompt_rec;
+    std::vector<int32_t> prompt_ids; // router top-K of every prompt token, in order (n_used per token)
+    std::vector<double>  rv;         // regret admission: decayed substituted gate mass per expert
+    std::vector<double>  rt;         // position of the last regret update
+    std::vector<int32_t> slot_map_host;
+    std::unordered_map<int, std::shared_ptr<llama_xc_job>> pend;
+
+    // hooks of the current graph
+    ggml_tensor * h_logits = nullptr;
+    ggml_tensor * h_ids    = nullptr;
+    ggml_tensor * h_w      = nullptr;
+    bool  norm_w  = true;
+    float w_scale = 1.0f;
+    bool  dirty   = false; // slot_map_host differs from the device copy
+
+    // pinned per-layer scratch for the small routing copies (async mode)
+    int32_t * io_gids = nullptr; // D2H: router ids
+    float   * io_gz   = nullptr; // D2H: router logits
+    int32_t * io_ids  = nullptr; // H2D: final ids
+    float   * io_w    = nullptr; // H2D: final weights
+    int32_t * io_map  = nullptr; // H2D: slot map
+};
+
+// policy / engine options (set per run with llama_xcache_set_opts, all off by default)
+struct llama_xc_opts {
+    bool   aio   = false; // async small copies on the compute stream, one sync per layer
+    bool   uf    = false; // urgent first: background reads do not start while urgent reads run
+    bool   upart = false; // urgent expert split into its tensor parts, read in parallel
+    bool   adm   = false; // admission: background-load a missed expert only if its score >= the victim's
+    bool   sbg   = false; // diagnostic: wait for all background loads at the end of every token
+    bool   bg    = true;  // background-load substituted misses (false: the set changes only through waited loads)
+    double lam   = 0.0;   // LRFU decay per token (0 = plain LRU)
+    int    pf    = 0;     // prefill: read expert tensors this many layers ahead into the page cache
+    bool   ef    = false; // prefill: start filling the cache of a layer as soon as its prompt routing is known
+    bool   ps    = false; // prefill streaming: read only the experts the prompt uses into a device staging area
+                          // (from the file, or from the slot pool when resident) and fill the cache from it
+    bool   fresh = false; // measurement: empty the slot pools at the start of every prompt
+    double pso   = 0.0;   // prompt streaming overlap: when a layer used at least this fraction of the experts, read all
+                          // non-resident experts of the next layer while the device computes (0 = off)
+    int    ram   = 1;     // 1 (default): per expert, copy from the page cache when it is resident there (mincore), read the file otherwise
+                          // 0: always read the file; 2: auto, as 1 when at least ramthr of the expert pages are resident, else 0 (decided per set_opts)
+    double ramthr = 0.5;
+    double fe    = 0.0;   // frequency score: EMA of uses with this weight per token (sets lam = -log2(1 - fe)); the score
+                          // starts from every use of the prompt and the initial set is the best-scored experts (0 = off)
+    bool   dk    = false; // demand keying: only the router's experts count as uses (not the substitutes)
+    double rb    = 0.0;   // rent-or-buy admission: a substituted expert accumulates its gate weight (decayed with half-life
+                          // rh tokens); when it reaches rb, it is read in the background in place of the lowest-scored
+                          // resident and its account is reset (0 = off)
+    double rh    = 512.0;
+    int    rq    = 8;     // at most this many admission reads in flight per layer
+};
+
+struct llama_xcache {
+    llama_xcache(const llama_model & model, const char * gguf_path, float frac_max);
+    ~llama_xcache();
+
+    bool layer_on(int il) const { return il >= 0 && il < (int) layers.size() && layers[il].il >= 0; }
+
+    // graph build
+    void          begin_graph();
+    ggml_tensor * get_pool(int il, ggml_tensor * src) const;
+    ggml_tensor * get_slot_map(int il) const { return layers[il].slot_map; }
+    void          hook_prefill(int il, ggml_tensor * ids);
+    void          hook_decode(int il, ggml_tensor * logits, ggml_tensor * ids, ggml_tensor * w, bool norm_w, float w_scale);
+
+    static bool eval_cb(ggml_tensor * t, bool ask, void * user_data);
+
+    void ubatch_done(int n_tokens);
+
+    // control
+    void begin_prompt();
+    void set_opts(const char * s);
+    void evict_host(); // drop the host expert pages (mapping and page cache), for cold-start measurements
+    bool prefill_stream() const { return opt.ps && buf_stage != nullptr; }
+    ggml_tensor * get_stage(int il, ggml_tensor * src) const;
+    int  configure(int mode, float frac, int src, float tau);
+    void get_stats(llama_xcache_stats * out) const;
+    bool   ram_on   = true;  // page cache source in effect (from opt.ram)
+    double ram_frac = -1;    // resident fraction of the expert pages at the last auto decision
+    bool want_callback() const { return mode != LLAMA_XC_IDEAL || capture_prompt || prefill_stream(); }
+
+    // state
+    int n_expert = 0;
+    int n_used   = 0;
+    int cap_max  = 0;
+    int cap      = 0;
+    int mode     = LLAMA_XC_EXACT;
+    int src      = LLAMA_XC_SRC_NVME;
+    float tau    = 2.0f;
+    bool capture_prompt = true;
+    double t_pos  = 0; // decode position for recency
+    int prompt_pos = 0;
+
+    std::vector<llama_xc_layer> layers;
+
+    llama_xc_opts      opt;
+    ggml_backend_t     be       = nullptr; // compute backend of the pool device (set by the context)
+    ggml_backend_dev_t pool_dev = nullptr;
+
+private:
+    struct hook { int il; int kind; };
+    std::unordered_map<const ggml_tensor *, hook> hooks;
+
+    ggml_context          * ctx_pool = nullptr;
+    ggml_backend_buffer_t   buf_pool = nullptr;
+    ggml_backend_buffer_t   buf_host = nullptr;
+    ggml_backend_buffer_t   buf_io   = nullptr;
+    ggml_context          * ctx_stage = nullptr;
+    ggml_backend_buffer_t   buf_stage = nullptr;
+    ggml_backend_buffer_type_t buft_dev = nullptr;
+    bool alloc_stage();
+    std::vector<uint8_t>    io_fallback;
+    uint8_t               * host_base = nullptr;
+    std::vector<uint8_t>    host_fallback;
+    size_t                  stage_size = 0;
+    int                     fd_direct = -1;
+    int                     fd_buffered = -1;
+
+    // stats
+    FILE * trace = nullptr; // env LLAMA_XCACHE_TRACE: decisions per layer and token (debugging)
+    double s_stall_ms = 0, s_wait_pending_ms = 0, s_cb_ms = 0, s_mass = 0;
+    int64_t s_ltok = 0;
+    int64_t s_tok = 0, s_want = 0, s_hit = 0, s_sub = 0, s_urg = 0, s_cancel = 0, s_drop = 0, s_steal = 0, s_skip = 0;
+    std::atomic<int64_t> s_bg{0};
+    std::atomic<int64_t> s_bytes{0};
+    // prompt processing (reset by begin_prompt)
+    double s_pf_ms = 0;
+    std::atomic<int64_t> s_pf_read{0};
+    std::atomic<int64_t> s_pf_d2d{0};
+    std::atomic<int64_t> s_pf_ram{0};
+    int64_t s_pf_used = 0; // sum over layers and ubatches of distinct experts used
+    int64_t s_pf_pre  = 0; // experts read ahead for the next layer
+    int64_t s_pf_pre_hit = 0; // of those, used
+    size_t expert_bytes = 0;
+
+    // background loader
+    std::vector<std::thread> bg_threads;
+    std::deque<std::shared_ptr<llama_xc_job>> bg_q;
+    std::mutex bg_mtx;
+    std::condition_variable bg_cv;
+    std::mutex done_mtx;
+    std::condition_variable done_cv;
+    std::atomic<int> n_outstanding{0};
+    std::atomic<bool> stopping{false};
+    std::atomic<int>  urg_active{0};
+
+    // prefill read-ahead
+    std::thread             pf_thread;
+    std::mutex              pf_mtx;
+    std::condition_variable pf_cv;
+    bool pf_on   = false;
+    int  pf_cur  = -1;
+    int  pf_next = 0;
+    void pf_worker();
+
+    // early fill during prefill
+    bool              ef_active = false;
+    int               ef_cap    = 0;
+    std::vector<char> ef_filled;
+
+    // urgent loader (parallel)
+    // kind: file -> pool slot, file -> staging, pool slot -> staging, staging -> pool slot
+    enum { XT_FILE_POOL = 0, XT_FILE_STAGE, XT_POOL_STAGE, XT_STAGE_POOL };
+    struct utask { int il; int e; int slot; int part = -1; int kind = XT_FILE_POOL; }; // part < 0: whole expert
+    struct ubatch {
+        std::vector<utask> tasks;
+        std::atomic<int>   next{0};
+        std::atomic<int>   left{0};
+    };
+    std::vector<std::thread> u_threads;
+    std::shared_ptr<ubatch> u_cur;
+    int u_gen = 0;
+    std::mutex u_mtx;
+    std::condition_variable u_cv;
+    std::condition_variable u_done_cv;
+
+    // prompt streaming read-ahead of the next layer (runs on the urgent workers while the device computes)
+    std::shared_ptr<ubatch> pre_b;
+    int               pre_for = -1;
+    std::vector<char> pre_have;
+    void wait_prefetch();
+
+
+    uint8_t * stage(int i) const { return host_base + (size_t) i * stage_size; }
+    const uint8_t * read_tensor_part(int il, int k, int e, uint8_t * dst);
+    void load_part(int il, int e, int slot, int k, uint8_t * stg, int kind = XT_FILE_POOL);
+    void load_expert(int il, int e, int slot, uint8_t * stg, bool yield_to_urgent = false, int kind = XT_FILE_POOL);
+    void d2d(ggml_tensor * a, size_t a_off, ggml_tensor * b, size_t b_off, size_t n);
+    static bool resident(const void * p, size_t n);
+    double resident_frac(); // sampled over every 4th MoE layer
+    std::vector<unsigned char> mc_vec;
+    void prefill_load(int il, const std::vector<int> & cnt);
+    void run_task(const utask & tk, uint8_t * stg);
+    void touch(llama_xc_layer & L, int e);
+    void dev_get(ggml_tensor * t, void * dst, size_t n);
+    void dev_set(ggml_tensor * t, const void * src, size_t n);
+    void run_urgent(const std::vector<utask> & tasks);
+    void bg_worker(int wid);
+    void u_worker(int wid);
+    void drain();
+    void poll(int il);
+    int  victim(int il, const std::vector<char> & prot) const;
+    int  assign(int il, int victim_e, int e);
+    int  slot_for_must(int il, int e, const std::vector<char> & prot, const std::vector<char> & psel);
+    int  claim(int il, int e);
+    void on_decode(int il);
+    void on_prefill(int il, ggml_tensor * ids);
+};
