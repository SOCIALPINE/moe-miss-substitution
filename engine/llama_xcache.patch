+
+//
+// expert cache
+//
+
+void llama_context::xcache_update_cb() {
+    if (xcache && xcache->want_callback()) {
+        cparams.cb_eval           = llama_xcache::eval_cb;
+        cparams.cb_eval_user_data = xcache.get();
+    } else {
+        cparams.cb_eval           = nullptr;
+        cparams.cb_eval_user_data = nullptr;
+    }
+    if (sched) {
+        ggml_backend_sched_set_eval_callback(sched.get(), cparams.cb_eval, cparams.cb_eval_user_data);
+    }
+}
+
+void llama_context::xcache_reset_graphs() {
+    // the prompt graph changes with the prompt streaming option
+    for (auto & res : gf_res_prev) {
+        if (res) {
+            res->reset();
+        }
+    }
+    gf_res_prev_active = nullptr;
+}
+
+bool llama_xcache_enabled(llama_context * ctx) {
+    return ctx->xcache != nullptr;
+}
+
+void llama_xcache_begin_prompt(llama_context * ctx) {
+    if (!ctx->xcache) {
+        return;
+    }
+    ctx->synchronize();
+    ctx->xcache->begin_prompt();
+    ctx->xcache_update_cb();
+}
+
+int32_t llama_xcache_configure(llama_context * ctx, const char * mode, float frac, const char * src, float tau) {
+    if (!ctx->xcache) {
+        return -1;
+    }
+    const std::string m = mode ? mode : "exact";
+    int im;
+    if      (m == "ideal")      { im = LLAMA_XC_IDEAL; }
+    else if (m == "ideal_sync") { im = LLAMA_XC_IDEAL_SYNC; }
+    else if (m == "exact")      { im = LLAMA_XC_EXACT; }
+    else if (m == "C")          { im = LLAMA_XC_C; }
+    else if (m == "B")          { im = LLAMA_XC_B; }
+    else { return -2; }
+    const int is = (src && std::string(src) == "ram") ? LLAMA_XC_SRC_RAM : LLAMA_XC_SRC_NVME;
+    ctx->synchronize();
+    const int32_t r = ctx->xcache->configure(im, frac, is, tau);
+    ctx->xcache_update_cb();
+    return r;
+}
+
+int32_t llama_xcache_set_opts(llama_context * ctx, const char * opts) {
+    if (!ctx->xcache) {
+        return -1;
+    }
+    ctx->synchronize();
+    const bool ps_old = ctx->xcache->prefill_stream();
+    ctx->xcache->set_opts(opts);
+    if (ctx->xcache->prefill_stream() != ps_old) {
+        ctx->xcache_reset_graphs();
+    }
+    ctx->xcache_update_cb();
+    return 0;
+}
+
+void llama_xcache_evict_host(llama_context * ctx) {
+    if (!ctx->xcache) {
+        return;
+    }
+    ctx->synchronize();
+    ctx->xcache->evict_host();
+}
+
+void llama_xcache_get_stats(llama_context * ctx, llama_xcache_stats * out) {
+    if (!ctx->xcache) {
+        *out = {};
+        return;
+    }
+    ctx->synchronize();
+    ctx->xcache->get_stats(out);
+}
